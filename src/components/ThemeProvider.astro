---
import { navGlassBlur } from "@/site.config";
---

{/* Inlined to avoid FOUC. This is a parser blocking script. */}
<script is:inline>
	const lightModePref = window.matchMedia("(prefers-color-scheme: light)");

	function getUserPref() {
		return getStoredTheme() || (lightModePref.matches ? "light" : "dark");
	}

	function getStoredTheme() {
		try {
			const theme = localStorage.getItem("theme");
			return theme === "light" || theme === "dark" ? theme : null;
		} catch {
			return null;
		}
	}

	function setTheme(newTheme, persist = false) {
		if (newTheme !== "light" && newTheme !== "dark") {
			return console.warn(
				`Invalid theme value '${newTheme}' received. Expected 'light' or 'dark'.`,
			);
		}

		const root = document.documentElement;

		root.setAttribute("data-theme", newTheme);

		if (persist) {
			try {
				localStorage.setItem("theme", newTheme);
			} catch {
				// 禁用存储时仍允许切换当前页面。
			}
		}
		document.dispatchEvent(new CustomEvent("theme-applied", { detail: { theme: newTheme } }));
	}

	// initial setup
	setTheme(getUserPref());

	// 主题切换动画（ThemeToggle.astro）通过 inline style 逐帧插值主题变量；
	// 若动画被页面切换/bfcache/系统主题变化打断，固定值与过渡类可能残留，
	// 这些路径负责清理（变量清单与 ThemeToggle.astro 的 THEME_VARS 保持一致）
	function cleanupThemeTransitionArtifacts() {
		const root = document.documentElement;
		for (const v of [
			"--color-global-bg",
			"--color-global-text",
			"--color-muted",
			"--color-link",
			"--color-accent",
			"--color-accent-2",
			"--color-quote",
		]) {
			root.style.removeProperty(v);
		}
		root.classList.remove("theme-transition");
	}

	// ClientRouter 页面切换会重置 <html> 属性（含 data-theme），切换后重新应用主题
	document.addEventListener("astro:after-swap", () => {
		cleanupThemeTransitionArtifacts();
		setTheme(getUserPref());
	});

	// listen for pageshow event, browser restored page from bfcache
	window.addEventListener("pageshow", (e) => {
		if (e.persisted) {
			cleanupThemeTransitionArtifacts();
			setTheme(getUserPref());
		}
	});

	// listen for theme-change custom event, fired in src/components/ThemeToggle.astro
	document.addEventListener("theme-change", (e) => {
		setTheme(e.detail.theme, true);
	});

	// listen for prefers-color-scheme change.
	lightModePref.addEventListener("change", (e) => {
		if (getStoredTheme()) return;
		cleanupThemeTransitionArtifacts();
		setTheme(e.matches ? "light" : "dark");
	});
	window.addEventListener("storage", (e) => {
		if (e.key !== "theme" && e.key !== null) return;
		cleanupThemeTransitionArtifacts();
		setTheme(getUserPref());
	});
</script>

<script is:inline define:vars={{ navGlassBlur }}>
	const blurKey = "nav-glass-blur";
	let blur = navGlassBlur.min;

	const isBlurValue = (value) =>
		Number.isInteger(value) && value >= navGlassBlur.min && value <= navGlassBlur.max;

	const applyBlur = (root) => root.style.setProperty("--nav-glass-blur", String(blur));

	function restoreBlur() {
		try {
			const stored = Number(localStorage.getItem(blurKey));
			blur = isBlurValue(stored) ? stored : navGlassBlur.min;
		} catch {
			// 存储被禁用时，继续在当前会话中使用已选强度。
		}
		applyBlur(document.documentElement);
		document.dispatchEvent(new Event("glass-blur-restored"));
	}

	restoreBlur();
	// 在交换文档前带上玻璃强度，新页面首帧就能使用当前设置。
	document.addEventListener("astro:before-swap", (event) => {
		applyBlur(event.newDocument.documentElement);
	});
	document.addEventListener("glass-blur-change", ({ detail }) => {
		if (!isBlurValue(detail?.value)) return;
		blur = detail.value;
		applyBlur(document.documentElement);
		if (detail.persist) {
			try {
				localStorage.setItem(blurKey, String(blur));
			} catch {}
		}
	});
	window.addEventListener("storage", (event) => {
		if (event.key === blurKey || event.key === null) restoreBlur();
	});
	window.addEventListener("pageshow", (event) => {
		if (event.persisted) restoreBlur();
	});
</script>
