<theme-toggle>
	<button class="hover:text-accent relative h-9 w-9 cursor-pointer p-2" type="button">
		<span class="sr-only">Dark Theme</span>
		<svg
			aria-hidden="true"
			class="absolute inset-s-1/2 top-1/2 h-7 w-7 -translate-x-1/2 -translate-y-1/2 scale-100 opacity-100 transition-all dark:scale-0 dark:opacity-0"
			fill="none"
			focusable="false"
			id="sun-svg"
			stroke-width="1.5"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path
				d="M12 18C15.3137 18 18 15.3137 18 12C18 8.68629 15.3137 6 12 6C8.68629 6 6 8.68629 6 12C6 15.3137 8.68629 18 12 18Z"
				stroke="currentColor"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
			<path d="M22 12L23 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
			></path>
			<path d="M12 2V1" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
			<path d="M12 23V22" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
			></path>
			<path d="M20 20L19 19" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
			></path>
			<path d="M20 4L19 5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
			></path>
			<path d="M4 20L5 19" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
			></path>
			<path d="M4 4L5 5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
			></path>
			<path d="M1 12L2 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
			></path>
		</svg>
		<svg
			aria-hidden="true"
			class="absolute inset-s-1/2 top-1/2 h-7 w-7 -translate-x-1/2 -translate-y-1/2 scale-0 opacity-0 transition-all dark:scale-100 dark:opacity-100"
			fill="none"
			focusable="false"
			id="moon-svg"
			stroke="currentColor"
			stroke-width="1.5"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path d="M0 0h24v24H0z" fill="none" stroke="none"></path>
			<path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z"
			></path>
			<path d="M17 4a2 2 0 0 0 2 2a2 2 0 0 0 -2 2a2 2 0 0 0 -2 -2a2 2 0 0 0 2 -2"></path>
			<path d="M19 11h2m-1 -1v2"></path>
		</svg>
	</button>
</theme-toggle>

<script>
	// Note that if you fire the theme-change event outside of this component, it will not be reflected in the button's aria-checked attribute. You will need to add an event listener if you want that.
	import { rootInDarkMode } from "@/utils/domElement";

	class ThemeToggle extends HTMLElement {
		constructor() {
			super();
			const button = this.querySelector<HTMLButtonElement>("button");

			if (button) {
				// set aria role value
				button.setAttribute("role", "switch");
				button.setAttribute("aria-checked", String(rootInDarkMode()));

			// button event
			button.addEventListener("click", (e) => {
				const nextTheme = rootInDarkMode() ? "light" : "dark";

				// dispatch event -> ThemeProvider.astro
				const applyTheme = () => {
					document.dispatchEvent(
						new CustomEvent("theme-change", { detail: { theme: nextTheme } }),
					);
				};

				// 减少动态效果偏好：直接切换，不做任何动画
				const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				const root = document.documentElement;

				if (reduceMotion) {
					applyTheme();
				} else if (document.startViewTransition) {
					// View Transitions：浏览器对切换前后两个状态截图，在合成器（GPU）上动画，
					// 帧率远高于逐帧重算整页的 CSS 变量过渡。
					// 不用默认的整页交叉淡化（新旧主题颜色互为反色，淡化会产生
					// "先变黑/白再变目标色"的双重曝光伪影），改为旧态垫底、新态从点击处圆形扩散揭示。
					// 注意：扩散动画时长必须小于浏览器默认动画（250ms）——部分 Chrome 版本
					// 会在默认动画结束时拆除过渡图层，动画跑不完会导致未覆盖的角落瞬间填满。
					root.classList.add("theme-reveal");
					const vt = document.startViewTransition(applyTheme);

					let revealAnim: Animation | undefined;
					vt.ready
						.then(() => {
							// 键盘触发时 clientX/Y 为 0，回退到按钮中心
							const rect = button.getBoundingClientRect();
							const x = e.clientX || rect.left + rect.width / 2;
							const y = e.clientY || rect.top + rect.height / 2;
							// 半径取视口全对角线（任意点击位置到最远角的距离都不超过它），
							// 再留 5% 余量，确保圆在动画结束前就完整覆盖屏幕
							const radius = Math.hypot(window.innerWidth, window.innerHeight) * 1.05;
							revealAnim = root.animate(
								{
									clipPath: [
										`circle(0px at ${x}px ${y}px)`,
										`circle(${radius}px at ${x}px ${y}px)`,
									],
								},
								{
									duration: 240,
									easing: "ease-out",
									pseudoElement: "::view-transition-new(root)",
								},
							);
						})
						.catch(() => {});

					vt.finished
						.catch(() => {})
						.finally(() => {
							// 显式清理动画：避免填充态的动画残留在已拆除的伪元素上，
							// 在部分浏览器（Edge）中引发切换后闪烁
							revealAnim?.cancel();
							root.classList.remove("theme-reveal");
						});
				} else {
					// 回退方案：临时启用颜色过渡（仅手动切换时有动画），避免页面加载时闪烁
					root.classList.add("theme-transition");
					window.setTimeout(() => root.classList.remove("theme-transition"), 350);
					applyTheme();
				}

				// set the aria-checked attribute
				button.setAttribute("aria-checked", String(rootInDarkMode()));
			});
			} else {
				console.warn("Theme Toggle: No button found");
			}
		}
	}

	customElements.define("theme-toggle", ThemeToggle);
</script>
