---
// Giscus 评论组件：基于 GitHub Discussions，读者用 GitHub 账号评论。
// 主题跟随站点明暗（通过监听 theme-change 事件动态切换 Giscus iframe）。
// 配置 ID 从仓库 GraphQL API 获取，详见 https://giscus.app
---

<section class="mt-16" data-pagefind-ignore>
	<div class="mb-6 flex items-baseline justify-between">
		<h2 class="title text-accent text-xl">评论</h2>
		<a
			class="cactus-link text-sm"
			href="https://github.com/yowakkojay/yowakkojay.github.io/discussions"
			rel="noreferrer"
			target="_blank"
			>管理评论 →</a
		>
	</div>
	<div class="giscus">
		<button class="cactus-link cursor-pointer text-sm" type="button" data-load-comments>加载评论</button>
		<p class="text-muted text-sm" role="status" data-comments-status>评论将在接近此处时加载，需要 GitHub 账号参与讨论。</p>
	</div>
</section>

<script>
	const giscusConfig = {
		repo: "yowakkojay/yowakkojay.github.io",
		"repo-id": "R_kgDOPHc27g",
		category: "General",
		"category-id": "DIC_kwDOPHc27s4DAAvI",
		mapping: "pathname",
		strict: "0",
		"reactions-enabled": "1",
		"emit-metadata": "0",
		"input-position": "top",
		lang: "zh-CN",
		// 主题根据当前站点 data-theme 决定，初始加载时确定
	};

	function currentGiscusTheme() {
		return document.documentElement.getAttribute("data-theme") === "dark"
			? "dark_dimmed"
			: "light";
	}

	function loadGiscus() {
		const container = document.querySelector(".giscus");
		if (!container || container.querySelector("iframe.giscus-frame, script")) return;
		const button = container.querySelector<HTMLButtonElement>("[data-load-comments]");
		const status = container.querySelector<HTMLElement>("[data-comments-status]");
		if (button) button.disabled = true;
		if (status) status.textContent = "正在连接评论服务…";

		const script = document.createElement("script");
		script.src = "https://giscus.app/client.js";
		script.async = true;
		script.crossOrigin = "anonymous";
		for (const [key, value] of Object.entries(giscusConfig)) {
			script.setAttribute(`data-${key}`, value);
		}
		script.setAttribute("data-theme", currentGiscusTheme());
		script.addEventListener("load", () => {
			button?.remove();
			status?.remove();
		});
		script.addEventListener("error", () => {
			script.remove();
			if (button) button.disabled = false;
			if (status) status.textContent = "评论暂时无法加载，可重试或前往 GitHub 讨论区。";
		});
		container.appendChild(script);
	}

	let observer: IntersectionObserver | null = null;
	document.addEventListener("astro:before-swap", () => observer?.disconnect());
	document.addEventListener("astro:page-load", () => {
		observer?.disconnect();
		const container = document.querySelector(".giscus");
		if (!container) return;
		container.querySelector("[data-load-comments]")?.addEventListener("click", loadGiscus);
		observer = new IntersectionObserver((entries) => {
			if (!entries.some((entry) => entry.isIntersecting)) return;
			observer?.disconnect();
			loadGiscus();
		}, { rootMargin: "240px" });
		observer.observe(container);
	});

	// 监听站点主题切换，动态通知 Giscus iframe 切换明暗主题
	function syncGiscusTheme() {
		const iframe = document.querySelector<HTMLIFrameElement>("iframe.giscus-frame");
		if (!iframe) return;
		iframe.contentWindow?.postMessage(
			{
				giscus: {
					setConfig: {
						theme: currentGiscusTheme(),
					},
				},
			},
			"https://giscus.app",
		);
	}

	// theme-change 事件由 ThemeToggle.astro 在用户切换主题时 dispatch。
	// iframe 重渲染评论是同步重活且与页面同线程，延后到整页渐变结束后再做，
	// 避免在 350ms 动画窗口内阻塞主线程（评论区本身随 iframe 自行换肤即可）
	let giscusSyncTimer: number | undefined;
	document.addEventListener("theme-applied", () => {
		window.clearTimeout(giscusSyncTimer);
		giscusSyncTimer = window.setTimeout(syncGiscusTheme, 450);
	});
	// bfcache 恢复时也同步一次
	window.addEventListener("pageshow", (e) => {
		if (e.persisted) syncGiscusTheme();
	});
</script>
