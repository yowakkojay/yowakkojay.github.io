---
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks, siteConfig } from "@/site.config";
---
<svg aria-hidden="true" focusable="false" width="0" height="0" style="position: absolute">
	<defs>
		<!-- 液态玻璃折射：横纵双线性渐变贴图（R/G 分轴编码位移），贴图首尾各留 6% 中性带，
		     位移在采样盒边缘归零，避免从玻璃外拉入未处理像素形成暗斑。
		     滤镜宿主 svg 不能 display:none（Blink 会忽略其中的滤镜）。 -->
		<filter id="liquid-glass-lens" x="-10%" y="-40%" width="120%" height="180%" color-interpolation-filters="sRGB">
			<feImage
				href="data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%3E%3Cdefs%3E%3ClinearGradient%20id='gx'%20x1='0'%20y1='0'%20x2='1'%20y2='0'%3E%3Cstop%20offset='0'%20stop-color='rgb(128,0,0)'/%3E%3Cstop%20offset='.06'%20stop-color='rgb(0,0,0)'/%3E%3Cstop%20offset='.5'%20stop-color='rgb(128,0,0)'/%3E%3Cstop%20offset='.94'%20stop-color='rgb(255,0,0)'/%3E%3Cstop%20offset='1'%20stop-color='rgb(128,0,0)'/%3E%3C/linearGradient%3E%3ClinearGradient%20id='gy'%20x1='0'%20y1='0'%20x2='0'%20y2='1'%3E%3Cstop%20offset='0'%20stop-color='rgb(0,128,0)'/%3E%3Cstop%20offset='.06'%20stop-color='rgb(0,0,0)'/%3E%3Cstop%20offset='.5'%20stop-color='rgb(0,128,0)'/%3E%3Cstop%20offset='.94'%20stop-color='rgb(0,255,0)'/%3E%3Cstop%20offset='1'%20stop-color='rgb(0,128,0)'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width='100%25'%20height='100%25'%20fill='url(%23gy)'/%3E%3Crect%20width='100%25'%20height='100%25'%20fill='url(%23gx)'%20style='mix-blend-mode:screen'/%3E%3C/svg%3E"
				x="0"
				y="0"
				width="100%"
				height="100%"
				preserveAspectRatio="none"
				result="lens-map"
			/>
			<feDisplacementMap in="SourceGraphic" in2="lens-map" scale="42" xChannelSelector="R" yChannelSelector="G" result="lensed" />
			<feTurbulence type="fractalNoise" baseFrequency="0.012 0.015" numOctaves="2" seed="11" result="noise" />
			<feGaussianBlur in="noise" stdDeviation="1.2" result="ripple" />
			<feDisplacementMap in="lensed" in2="ripple" scale="8" xChannelSelector="R" yChannelSelector="G" />
		</filter>
	</defs>
</svg>

<header class="glass-header glass-surface" id="main-header">
	<span class="glass-layers" aria-hidden="true"><span class="glass-optical"></span><span class="glass-warp"></span></span>
	<span class="glass-tint" aria-hidden="true"></span>
	<a class="glass-brand" href="/" aria-label={`${siteConfig.title} · 首页`}>
		<img alt="" src="/killua.webp" width="38" height="38" />
		<span>{siteConfig.title}</span>
	</a>
	<nav class="glass-nav glass-surface" aria-label="主导航" id="navigation-menu">
		<span class="glass-layers" aria-hidden="true"><span class="glass-optical"></span><span class="glass-warp"></span></span>
		<span class="glass-tint" aria-hidden="true"></span>
		<glass-navigation>
			<span class="glass-indicator" aria-hidden="true"></span>
			{menuLinks.map((link) => (
				<a
					aria-current={(link.path === "/" ? Astro.url.pathname === "/" : Astro.url.pathname.startsWith(link.path)) ? "page" : undefined}
					href={link.path}
				>{link.title}</a>
			))}
		</glass-navigation>
	</nav>
	<div class="glass-actions">
		<Search />
		<ThemeToggle />
		<button
			aria-expanded="false"
			aria-controls="navigation-menu"
			aria-label="打开导航菜单"
			class="glass-menu-button"
			id="toggle-navigation-menu"
			type="button"
		>
			<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
				<path class="menu-line" d="M5 8h14M5 16h14" />
				<path class="menu-cross" d="m7 7 10 10M7 17 17 7" />
			</svg>
		</button>
	</div>
</header>

<style>
	/* 玻璃放在伪元素/子元素上，避免 header 自身成为 backdrop root，影响移动端浮层。 */
	.glass-surface {
		/* iOS 液态玻璃：底色近乎全透明，质感全部来自饱和提亮与边缘光学。 */
		--glass-tint: color-mix(in srgb, var(--color-global-bg) 3%, transparent);
		--glass-brightness: 1.06;
		--glass-lens: url(#liquid-glass-lens);
		--rim-peak: rgb(255 255 255 / 58%);
		--rim-faint: rgb(255 255 255 / 15%);
		--rim-blue: rgb(150 200 255 / 18%);
		--rim-pink: rgb(255 155 195 / 13%);
		--glass-glow: rgb(255 255 255 / 24%);
		--glass-shadow: rgb(26 36 48 / 9%);
		/* 亮色下滑块胶囊：白底上要靠描边和投影才够明显。 */
		--chip-fill: color-mix(in srgb, var(--color-global-text) 9%, transparent);
		--chip-ring: color-mix(in srgb, var(--color-global-text) 12%, transparent);
		--chip-shadow: rgb(0 0 0 / 9%);
		isolation: isolate;
	}
	:global([data-theme="dark"]) .glass-surface {
		--glass-tint: color-mix(in srgb, var(--color-global-bg) 5%, transparent);
		--glass-brightness: 1.38;
		--rim-peak: rgb(255 255 255 / 30%);
		--rim-faint: rgb(255 255 255 / 9%);
		--rim-blue: rgb(130 180 255 / 14%);
		--rim-pink: rgb(255 145 190 / 10%);
		--glass-glow: rgb(255 255 255 / 15%);
		--glass-shadow: rgb(0 0 0 / 30%);
		--chip-fill: color-mix(in srgb, var(--color-global-text) 7%, transparent);
		--chip-ring: rgb(255 255 255 / 14%);
		--chip-shadow: rgb(0 0 0 / 28%);
	}
	.glass-layers,
	.glass-tint,
	.glass-surface::after {
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		pointer-events: none;
	}
	.glass-surface::after {
		content: "";
	}
	/* 采样层包在裁剪盒里：光学/位移层比可见玻璃大 2rem，位移采样落在玻璃外一圈
	   真实且已经同样提亮过的内容上，不会拉入快照边界外的原始像素；溢出被裁掉。 */
	.glass-layers {
		overflow: hidden;
	}
	.glass-optical,
	.glass-warp {
		position: absolute;
		inset: -2rem;
		pointer-events: none;
	}
	.glass-optical {
		-webkit-backdrop-filter: blur(2px) saturate(180%) brightness(var(--glass-brightness));
		backdrop-filter: blur(2px) saturate(180%) brightness(var(--glass-brightness));
	}
	.glass-warp {
		/* 仅 Chromium 渲染 SVG 位移；Safari/Firefox 自动退化为无此层。 */
		-webkit-backdrop-filter: var(--glass-lens);
		backdrop-filter: var(--glass-lens);
	}
	.glass-tint {
		/* 不支持 backdrop-filter 时使用实色，保证文字可读。 */
		background-color: var(--color-global-bg);
		box-shadow:
			0 14px 36px -18px var(--glass-shadow),
			0 2px 10px -6px var(--glass-shadow),
			inset 0 1px 0.5px rgb(255 255 255 / 24%),
			inset 0 -10px 14px -12px rgb(255 255 255 / 9%);
	}
	@supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		.glass-tint {
			background-color: var(--glass-tint);
			background-image:
				radial-gradient(200px 24px at var(--glass-x, 30%) 0%, var(--glass-glow), transparent 75%),
				linear-gradient(160deg, rgb(255 255 255 / 3%), transparent 45%, rgb(255 255 255 / 1%));
		}
	}
	.glass-surface::after {
		/* 边缘环：主高光弧朝向光源（--light-angle），两侧带轻微蓝/粉色散，模拟厚玻璃镜边。 */
		padding: 1.1px;
		background:
			conic-gradient(
				from calc(var(--light-angle, 310deg) + 11deg),
				transparent 0deg 48deg,
				var(--rim-blue) 80deg,
				transparent 116deg 360deg
			),
			conic-gradient(
				from calc(var(--light-angle, 310deg) - 11deg),
				transparent 0deg 48deg,
				var(--rim-pink) 80deg,
				transparent 116deg 360deg
			),
			conic-gradient(
				from calc(var(--light-angle, 310deg) - 130deg),
				transparent 0deg,
				var(--rim-faint) 80deg,
				var(--rim-peak) 130deg,
				var(--rim-faint) 180deg,
				transparent 260deg 360deg
			);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		mask-composite: exclude;
	}
	.glass-header {
		position: sticky;
		top: max(1rem, env(safe-area-inset-top));
		z-index: 60;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		min-height: 4rem;
		margin-bottom: 4rem;
		padding: 0.5rem 0.625rem 0.5rem 0.75rem;
		border-radius: 2.5rem;
	}
	.glass-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		min-width: 0;
		color: var(--color-accent-2);
		font-size: 1rem;
		font-weight: 650;
		letter-spacing: -0.035em;
		white-space: nowrap;
		border-radius: 999px;
	}
	.glass-brand img {
		flex-shrink: 0;
		width: 2.375rem;
		height: 2.375rem;
		border-radius: 50%;
		object-fit: cover;
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-global-text) 10%, transparent);
	}
	.glass-nav {
		position: absolute;
		inset: calc(100% + 0.625rem) 0 auto;
		display: none;
		padding: 0.5rem;
		border-radius: 1.75rem;
	}
	.glass-header[data-menu-open] .glass-nav {
		display: block;
		animation: glass-menu-in 460ms cubic-bezier(0.3, 0.6, 0.35, 1);
		transform-origin: 50% 0;
	}
	glass-navigation {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		/* 横屏和放大文字时仍能滚动到最后一项，不让菜单伸出可视区域。 */
		max-height: max(2.75rem, calc(100vh - 9rem));
		max-height: max(2.75rem, calc(100dvh - 9rem - env(safe-area-inset-top) - env(safe-area-inset-bottom)));
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-width: thin;
	}
	glass-navigation a {
		position: relative;
		padding: 0.625rem 1rem;
		border-radius: 999px;
		color: var(--color-global-text);
		font-size: 0.9375rem;
		font-weight: 550;
		line-height: 1.5rem;
		white-space: nowrap;
		transition:
			color 180ms ease,
			transform 360ms cubic-bezier(0.3, 1.3, 0.4, 1);
		text-shadow: 0 1px 6px color-mix(in srgb, var(--color-global-bg) 80%, transparent);
	}
	glass-navigation a:active {
		transform: scale(0.96);
	}
	glass-navigation a[aria-current="page"] {
		color: var(--color-accent);
		font-weight: 650;
		background: color-mix(in srgb, var(--color-global-text) 5%, transparent);
	}
	.glass-indicator {
		display: none;
		position: absolute;
		inset: 0 auto auto 0;
		width: 0;
		height: 0;
		border-radius: 999px;
		opacity: 0;
		/* 桌面端胶囊是一枚小玻璃片：顶部受光、细描边定形、底部投影，随选中项液态滑动。 */
		background: var(--chip-fill);
		box-shadow:
			inset 0 1px 0.5px rgb(255 255 255 / 30%),
			inset 0 0 0 0.5px var(--chip-ring),
			0 2px 8px var(--chip-shadow);
		transition:
			transform 520ms cubic-bezier(0.32, 1.35, 0.42, 1),
			width 520ms cubic-bezier(0.32, 1.35, 0.42, 1),
			height 520ms cubic-bezier(0.32, 1.35, 0.42, 1),
			opacity 180ms ease;
	}
	.glass-actions {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		gap: 0.125rem;
	}
	.glass-actions :global(theme-toggle),
	.glass-actions :global(pagefind-modal-trigger) {
		display: block;
	}
	.glass-actions :global(theme-toggle button),
	.glass-actions :global(.pf-trigger-btn),
	.glass-menu-button {
		display: grid;
		place-items: center;
		width: 2.625rem;
		height: 2.625rem;
		border-radius: 50%;
		cursor: pointer;
		transition: background-color 180ms ease, transform 180ms ease;
	}
	@media (hover: hover) {
		.glass-actions :global(theme-toggle button:hover),
		.glass-actions :global(.pf-trigger-btn:hover),
		.glass-menu-button:hover {
			background-color: color-mix(in srgb, var(--color-global-text) 6%, transparent);
		}
	}
	.glass-actions :global(theme-toggle button:active),
	.glass-actions :global(.pf-trigger-btn:active),
	.glass-menu-button:active {
		transform: scale(0.94);
	}
	.glass-header :global(a:focus-visible),
	.glass-header :global(button:focus-visible) {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}
	.glass-menu-button svg {
		width: 1.5rem;
		height: 1.5rem;
	}
	.menu-cross,
	.glass-menu-button[aria-expanded="true"] .menu-line {
		opacity: 0;
	}
	.glass-menu-button[aria-expanded="true"] .menu-cross {
		opacity: 1;
	}
	@keyframes glass-menu-in {
		/* 不能给玻璃的祖先做 opacity 动画：opacity < 1 会建立新的 backdrop root，
		   子层采样不到页面，结束时才恢复模糊，形成透明→玻璃的闪烁。
		   弹性过冲（先落下再回弹 2px）只靠 transform 实现，玻璃材质全程不变。 */
		0% {
			transform: translateY(-14px) scale(0.94);
		}
		60% {
			transform: translateY(2px) scale(1.012);
		}
		100% {
			transform: translateY(0) scale(1);
		}
	}
	@media (min-width: 48rem) {
		.glass-header { padding-inline: 0.875rem 0.625rem; }
		.glass-brand { font-size: 1.125rem; }
		.glass-nav,
		.glass-header[data-menu-open] .glass-nav {
			position: relative;
			inset: auto;
			display: block;
			padding: 0;
			animation: none;
		}
		.glass-nav .glass-layers,
		.glass-nav .glass-tint,
		.glass-nav::after { display: none; }
		glass-navigation { flex-direction: row; max-height: none; overflow: visible; }
		glass-navigation a { padding-inline: 0.875rem; }
		glass-navigation[data-ready] a[aria-current="page"] { background: transparent; }
		.glass-indicator { display: block; }
		.glass-menu-button { display: none; }
	}
	@media (max-width: 23rem) {
		.glass-brand { gap: 0.375rem; font-size: 0.875rem; }
		.glass-brand img { width: 1.875rem; height: 1.875rem; }
		.glass-actions :global(theme-toggle button),
		.glass-actions :global(.pf-trigger-btn),
		.glass-menu-button { width: 2.25rem; height: 2.25rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.glass-indicator,
		glass-navigation a,
		.glass-actions :global(button) { transition: none; }
		.glass-header[data-menu-open] .glass-nav { animation: none; }
	}
	@media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
		.glass-optical,
		.glass-warp {
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}
		.glass-tint {
			background-color: var(--color-global-bg);
			background-image: none;
			box-shadow:
				0 14px 36px -18px var(--glass-shadow),
				0 2px 10px -6px var(--glass-shadow),
				inset 0 0 0 1px var(--color-muted);
		}
		.glass-surface::after {
			display: none;
		}
	}
</style>

<script>
	// 上一次滑块的几何（模块级变量，ClientRouter 换页时存活）：
	// 导航重建后滑块从上一页的位置滑到新页的当前项，而不是从 0 尺寸缩放弹出。
	let lastChip: { x: number; y: number; width: number; height: number } | null = null;

	class GlassNavigation extends HTMLElement {
		#controller: AbortController | undefined;
		#resize: ResizeObserver | undefined;
		#frame = 0;

		connectedCallback() {
			this.#controller?.abort();
			this.#resize?.disconnect();
			cancelAnimationFrame(this.#frame);
			this.#frame = 0;
			this.#controller = new AbortController();
			const { signal } = this.#controller;
			const header = this.closest<HTMLElement>("header");
			const indicator = this.querySelector<HTMLElement>(".glass-indicator");
			const button = header?.querySelector<HTMLButtonElement>(".glass-menu-button");
			if (!header || !indicator || !button) return;
			const desktop = window.matchMedia("(min-width: 48rem)");
			const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
			let current = this.querySelector<HTMLAnchorElement>('[aria-current="page"]');
			const placeChip = (link: HTMLAnchorElement) => {
				indicator.style.width = `${link.offsetWidth}px`;
				indicator.style.height = `${link.offsetHeight}px`;
				indicator.style.transform = `translate(${link.offsetLeft}px, ${link.offsetTop}px)`;
				indicator.style.opacity = "1";
				lastChip = { x: link.offsetLeft, y: link.offsetTop, width: link.offsetWidth, height: link.offsetHeight };
			};
			const moveTo = (link: HTMLAnchorElement | null, animate = true) => {
				// 手机端只用 aria-current 标记所在页，不能把触摸/焦点当成选中态。
				if (!desktop.matches || !link || !this.offsetWidth) {
					indicator.style.opacity = "0";
					return;
				}
				if (animate) {
					placeChip(link);
				}
				else {
					// 首次落位/尺寸变化：先关过渡直接就位并强制重算提交，再恢复过渡，
					// 避免滑块从 0 尺寸初始态带动画定位（缩放弹出）。
					indicator.style.transition = "none";
					placeChip(link);
					void indicator.offsetWidth;
					indicator.style.transition = "";
				}
				this.dataset.ready = "";
			};
			const reset = (animate = true) => {
				const focused = this.contains(document.activeElement) && document.activeElement instanceof HTMLAnchorElement ? document.activeElement : current;
				moveTo(focused, animate);
			};
			const setOpen = (open: boolean) => {
				header.toggleAttribute("data-menu-open", open);
				button.setAttribute("aria-expanded", String(open));
				button.setAttribute("aria-label", open ? "关闭导航菜单" : "打开导航菜单");
				if (!desktop.matches) {
					if (open) {
						const target = current ?? this.querySelector("a");
						if (target) {
							target.focus({ preventScroll: true });
							this.scrollTop = target.offsetTop - (this.clientHeight - target.offsetHeight) / 2;
						}
					}
					else if (this.contains(document.activeElement)) button.focus({ preventScroll: true });
				}
				reset();
			};
			button.addEventListener("click", () => setOpen(!header.hasAttribute("data-menu-open")), { signal });
			this.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
				link.addEventListener("pointerenter", (event) => {
					if (event.pointerType === "mouse") moveTo(link);
				}, { signal });
				link.addEventListener("focus", () => moveTo(link), { signal });
				link.addEventListener("click", () => setOpen(false), { signal });
			});
			this.addEventListener("pointerleave", () => reset(), { signal });
			this.addEventListener("focusout", () => queueMicrotask(() => reset()), { signal });
			header.addEventListener("focusout", (event) => {
				// Safari 点按按钮可能先把焦点交给 body（relatedTarget=null）。
				// 这种情况交由 click 处理，否则会先关闭、再被同一次 click 重新打开。
				const next = event.relatedTarget;
				if (next instanceof Node && next !== document.body && !header.contains(next)) setOpen(false);
			}, { signal });
			header.addEventListener("click", (event) => {
				if (event.target instanceof Element && event.target.closest("theme-toggle, pagefind-modal-trigger")) setOpen(false);
			}, { signal });
			document.addEventListener("pointerdown", (event) => {
				if (event.target instanceof Node && !header.contains(event.target)) setOpen(false);
			}, { signal });
			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && header.hasAttribute("data-menu-open")) {
					setOpen(false);
					button.focus();
				}
			}, { signal });
			desktop.addEventListener("change", () => setOpen(false), { signal });
			// 高光位置与光源角度都用百分比/角度保留，离开后停在最后状态，不再复位到固定坐标。
			const startGlow = Number.parseFloat(header.style.getPropertyValue("--glass-x"));
			const startAngle = Number.parseFloat(getComputedStyle(header).getPropertyValue("--light-angle"));
			let glowPosition = Number.isFinite(startGlow) ? startGlow : 30;
			let lightAngle = Number.isFinite(startAngle) ? (((startAngle % 360) + 360) % 360) : 310;
			let glowTarget = glowPosition;
			let angleTarget = lightAngle;
			let lastFrame = 0;
			const followLight = (now: number) => {
				this.#frame = 0;
				if (signal.aborted || reducedMotion.matches) return;
				const elapsed = lastFrame ? Math.min(now - lastFrame, 64) : 16;
				lastFrame = now;
				const ease = 1 - Math.exp(-elapsed / 65);
				glowPosition += (glowTarget - glowPosition) * ease;
				// 角度走最短弧，避免从 350° 追 10° 时反向转一大圈。
				const shortestAngle = ((((angleTarget - lightAngle) % 360) + 540) % 360) - 180;
				lightAngle = (((lightAngle + shortestAngle * ease) % 360) + 360) % 360;
				const glowSettled = Math.abs(glowTarget - glowPosition) < 0.02;
				const angleSettled = Math.abs(shortestAngle) < 0.05;
				if (glowSettled) glowPosition = glowTarget;
				if (angleSettled) lightAngle = angleTarget;
				header.style.setProperty("--glass-x", `${glowPosition}%`);
				header.style.setProperty("--light-angle", `${lightAngle}deg`);
				if (!glowSettled || !angleSettled) this.#frame = requestAnimationFrame(followLight);
			};
			header.addEventListener("pointermove", (event) => {
				if (event.pointerType !== "mouse" || reducedMotion.matches) return;
				const rect = header.getBoundingClientRect();
				if (!rect.width) return;
				glowTarget = Math.max(0, Math.min(100, ((event.clientX - rect.left) / rect.width) * 100));
				// 镜边高光朝向指针：conic 0° 朝上，atan2 的 0° 朝右，换算后指针在右时高光在右。
				const lightSource = Math.atan2(event.clientY - (rect.top + rect.height / 2), event.clientX - (rect.left + rect.width / 2)) * (180 / Math.PI) + 90;
				angleTarget = ((lightSource % 360) + 360) % 360;
				if (!this.#frame) {
					lastFrame = 0;
					this.#frame = requestAnimationFrame(followLight);
				}
			}, { signal, passive: true });
			// observe() 会先发一次初始通知，跳过它，否则会打断首次落位的滑入动画。
			let resizePrimed = false;
			this.#resize = new ResizeObserver(() => {
				if (!resizePrimed) {
					resizePrimed = true;
					return;
				}
				reset(false);
			});
			this.#resize.observe(this);
			// 首次落位：客户端导航重建后从上一页的位置滑到新页当前项；首次访问直接就位。
			const initial = current ?? this.querySelector<HTMLAnchorElement>("a");
			if (desktop.matches && initial && this.offsetWidth && lastChip) {
				indicator.style.transition = "none";
				indicator.style.width = `${lastChip.width}px`;
				indicator.style.height = `${lastChip.height}px`;
				indicator.style.transform = `translate(${lastChip.x}px, ${lastChip.y}px)`;
				indicator.style.opacity = "1";
				void indicator.offsetWidth;
				indicator.style.transition = "";
				placeChip(initial);
				this.dataset.ready = "";
			}
			else {
				reset(false);
			}
			document.addEventListener("astro:page-load", () => {
				// 保险：若组件在客户端导航中被保留（未重建），aria-current 已更新但引用过期，滑到新的当前项。
				const latest = this.querySelector<HTMLAnchorElement>('[aria-current="page"]');
				if (latest && latest !== current) {
					current = latest;
					reset();
				}
			}, { signal });
		}

		disconnectedCallback() {
			this.#controller?.abort();
			this.#resize?.disconnect();
			cancelAnimationFrame(this.#frame);
			this.#frame = 0;
		}
	}
	customElements.define("glass-navigation", GlassNavigation);
</script>
