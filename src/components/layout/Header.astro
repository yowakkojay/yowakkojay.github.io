---
import { Icon } from "astro-icon/components";
import AppearanceSettings from "@/components/AppearanceSettings.astro";
import Search from "@/components/Search.astro";
import { menuLinks, siteConfig } from "@/site.config";
---
<svg aria-hidden="true" focusable="false" width="0" height="0" style="position: absolute">
	<defs>
		<!-- 液态玻璃折射：横纵双线性渐变贴图（R/G 分轴编码位移），边缘向内拉、中心不变形——
		     厚玻璃边缘的弯折方向。边缘只采样玻璃内部已提亮的内容，不会拉入外部暗色像素。
		     滤镜宿主 svg 不能 display:none（Blink 会忽略其中的滤镜）。 -->
		<filter id="liquid-glass-lens" x="-10%" y="-40%" width="120%" height="180%" color-interpolation-filters="sRGB">
			<feImage
				href="data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%3E%3Cdefs%3E%3ClinearGradient%20id='gx'%20x1='0'%20y1='0'%20x2='1'%20y2='0'%3E%3Cstop%20offset='0'%20stop-color='rgb(255,0,0)'/%3E%3Cstop%20offset='.5'%20stop-color='rgb(128,0,0)'/%3E%3Cstop%20offset='1'%20stop-color='rgb(0,0,0)'/%3E%3C/linearGradient%3E%3ClinearGradient%20id='gy'%20x1='0'%20y1='0'%20x2='0'%20y2='1'%3E%3Cstop%20offset='0'%20stop-color='rgb(0,255,0)'/%3E%3Cstop%20offset='.5'%20stop-color='rgb(0,128,0)'/%3E%3Cstop%20offset='1'%20stop-color='rgb(0,0,0)'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width='100%25'%20height='100%25'%20fill='url(%23gy)'/%3E%3Crect%20width='100%25'%20height='100%25'%20fill='url(%23gx)'%20style='mix-blend-mode:screen'/%3E%3C/svg%3E"
				x="0"
				y="0"
				width="100%"
				height="100%"
				preserveAspectRatio="none"
				result="lens-map"
			/>
			<feDisplacementMap in="SourceGraphic" in2="lens-map" scale="42" xChannelSelector="R" yChannelSelector="G" result="lensed" />
			<feTurbulence type="fractalNoise" baseFrequency="0.012 0.015" numOctaves="2" seed="11" result="noise" />
			<feGaussianBlur in="noise" stdDeviation="1.2" result="ripple" />
			<feDisplacementMap in="lensed" in2="ripple" scale="8" xChannelSelector="R" yChannelSelector="G" />
		</filter>
	</defs>
	<defs id="mobile-glass-filters"></defs>
</svg>

<header class="glass-header glass-surface" id="main-header">
	<span class="glass-layers" aria-hidden="true"><span class="glass-optical"></span><span class="glass-warp"></span></span>
	<span class="glass-tint" aria-hidden="true"></span>
	<a class="glass-brand" href="/" aria-label={`${siteConfig.title} · 首页`}>
		<img alt="" src="/killua.webp" width="38" height="38" />
		<span>{siteConfig.title}</span>
	</a>
	<nav class="glass-nav glass-surface" aria-label="主导航" id="navigation-menu">
		<span class="glass-layers" aria-hidden="true"><span class="glass-optical"></span><span class="glass-warp"></span></span>
		<div class="glass-refraction glass-dock-refraction" aria-hidden="true" inert hidden><div class="glass-refraction-sample"></div></div>
		<span class="glass-tint" aria-hidden="true"></span>
		<glass-navigation>
			<div class="glass-refraction glass-chip-refraction" aria-hidden="true" inert hidden><div class="glass-refraction-sample"></div></div>
			<span class="glass-indicator" aria-hidden="true"></span>
			{menuLinks.map((link) => (
				<a
					aria-current={(link.path === "/" ? Astro.url.pathname === "/" : Astro.url.pathname.startsWith(link.path)) ? "page" : undefined}
					href={link.path}
					draggable="false"
					>
						<Icon aria-hidden="true" class="glass-nav-icon" name={link.icon} />
						<span>{link.title}</span>
					</a>
			))}
		</glass-navigation>
	</nav>
	<div class="glass-actions">
		<Search />
		<AppearanceSettings />
	</div>
</header>

<style>
	/* 玻璃放在伪元素/子元素上，避免 header 自身成为 backdrop root，影响移动端浮层。 */
	.glass-surface {
		/* 模糊和底色同步增加，正文滚到导航下面时文字仍能读清。 */
		--glass-strength: var(--nav-glass-blur, 2);
		--glass-blur: calc(var(--glass-strength) * 1px);
		--glass-tint: color-mix(in srgb, var(--color-global-bg) calc(28% + var(--glass-strength) * 4.5%), transparent);
		--glass-edge-tint: color-mix(in srgb, var(--color-global-bg) calc(25% + var(--glass-strength) * 2.5%), transparent);
		--glass-brightness: 1.06;
		--glass-lens: url(#liquid-glass-lens);
		--rim-peak: rgb(255 255 255 / 58%);
		--rim-faint: rgb(255 255 255 / 15%);
		--rim-blue: rgb(150 200 255 / 18%);
		--rim-pink: rgb(255 155 195 / 13%);
		--glass-glow: rgb(255 255 255 / 24%);
		--glass-shadow: rgb(26 36 48 / 9%);
		/* 亮色下滑块胶囊：白底上要靠描边和投影才够明显。 */
		--chip-fill: color-mix(in srgb, var(--color-global-text) 9%, transparent);
		--chip-ring: color-mix(in srgb, var(--color-accent) 32%, transparent);
		--chip-shadow: rgb(0 0 0 / 9%);
		--chip-highlight: rgb(255 255 255 / 75%);
		--chip-drag-glow: rgb(255 255 255 / 45%);
		--chip-lift-shadow: rgb(0 0 0 / 16%);
		isolation: isolate;
	}
	:global([data-theme="dark"]) .glass-surface {
		--glass-tint: color-mix(in srgb, var(--color-global-bg) calc(50% + var(--glass-strength) * 3.5%), transparent);
		--glass-edge-tint: color-mix(in srgb, var(--color-global-bg) calc(35% + var(--glass-strength) * 3.75%), transparent);
		--glass-brightness: 1.38;
		--rim-peak: rgb(255 255 255 / 30%);
		--rim-faint: rgb(255 255 255 / 9%);
		--rim-blue: rgb(130 180 255 / 14%);
		--rim-pink: rgb(255 145 190 / 10%);
		--glass-glow: rgb(255 255 255 / 15%);
		--glass-shadow: rgb(0 0 0 / 30%);
		--chip-fill: color-mix(in srgb, var(--color-global-text) 7%, transparent);
		--chip-ring: color-mix(in srgb, var(--color-accent) 28%, transparent);
		--chip-shadow: rgb(0 0 0 / 28%);
		--chip-highlight: rgb(255 255 255 / 35%);
		--chip-drag-glow: rgb(255 255 255 / 22%);
		--chip-lift-shadow: rgb(0 0 0 / 48%);
	}
	.glass-layers,
	.glass-tint,
	.glass-surface::after {
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		pointer-events: none;
	}
	.glass-surface::after {
		content: "";
	}
	/* 采样层包在裁剪盒里：光学/位移层比可见玻璃大 2rem，位移采样落在玻璃外一圈
	   真实且已经同样提亮过的内容上，不会拉入快照边界外的原始像素；溢出被裁掉。 */
	.glass-layers {
		overflow: hidden;
	}
	.glass-optical,
	.glass-warp {
		position: absolute;
		inset: -2rem;
		pointer-events: none;
	}
	/* 默认（WebKit/Gecko）：基础光学层承担模糊、饱和与提亮。 */
	.glass-optical {
		-webkit-backdrop-filter: blur(var(--glass-blur)) saturate(135%) brightness(var(--glass-brightness));
		backdrop-filter: blur(var(--glass-blur)) saturate(135%) brightness(var(--glass-brightness));
	}
	.glass-warp {
		display: none;
	}
	/* Chromium：单层同时承担位移+模糊+饱和+提亮，避免双层 backdrop 叠加的合成误差。
	   Safari/Firefox 的声明虽合法但不渲染 SVG 位移，故用引擎嗅探切换。 */
	.glass-surface[data-warp] .glass-optical {
		display: none;
	}
	.glass-surface[data-warp] .glass-warp {
		display: block;
		-webkit-backdrop-filter: var(--glass-lens) blur(var(--glass-blur)) saturate(135%) brightness(var(--glass-brightness));
		backdrop-filter: var(--glass-lens) blur(var(--glass-blur)) saturate(135%) brightness(var(--glass-brightness));
	}
	.glass-tint {
		/* 不支持 backdrop-filter 时使用实色，保证文字可读。 */
		background-color: var(--color-global-bg);
		box-shadow:
			0 14px 36px -18px var(--glass-shadow),
			0 2px 10px -6px var(--glass-shadow),
			inset 0 1px 0.5px rgb(255 255 255 / 24%),
			inset 0 -10px 14px -12px rgb(255 255 255 / 9%);
	}
	@supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) and (background-color: color-mix(in srgb, white calc(20% * 2), transparent)) {
		.glass-tint {
			background-color: var(--glass-underlay, transparent);
			background-image:
				radial-gradient(var(--glass-glow-size, 200px 24px) at var(--glass-x, 30%) 0%, var(--glass-glow), transparent 75%),
				linear-gradient(90deg, var(--glass-edge-tint), var(--glass-tint) 18% 82%, var(--glass-edge-tint));
		}
	}
	.glass-surface::after {
		/* 边缘环：主高光弧朝向光源（--light-angle），两侧带轻微蓝/粉色散，模拟厚玻璃镜边。 */
		padding: var(--glass-rim-width, 1.1px);
		background:
			conic-gradient(
				from calc(var(--light-angle, 310deg) - 69deg),
				transparent 0deg 48deg,
				var(--rim-blue) 80deg,
				transparent 116deg 360deg
			),
			conic-gradient(
				from calc(var(--light-angle, 310deg) - 91deg),
				transparent 0deg 48deg,
				var(--rim-pink) 80deg,
				transparent 116deg 360deg
			),
			conic-gradient(
				from calc(var(--light-angle, 310deg) - 130deg),
				transparent 0deg,
				var(--rim-faint) 80deg,
				var(--rim-peak) 130deg,
				var(--rim-faint) 180deg,
				transparent 260deg 360deg
			),
			var(--glass-bevel, none);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		mask-composite: exclude;
	}
	.glass-header {
		position: sticky;
		top: max(1rem, env(safe-area-inset-top));
		z-index: 60;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		min-height: 4rem;
		margin-bottom: 4rem;
		padding: 0.5rem 0.625rem 0.5rem 0.875rem;
		border-radius: 2.5rem;
	}
	.glass-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		min-width: 0;
		color: var(--color-accent-2);
		font-size: 1.125rem;
		font-weight: 650;
		letter-spacing: -0.035em;
		white-space: nowrap;
		border-radius: 999px;
	}
	.glass-brand img {
		flex-shrink: 0;
		width: 2.375rem;
		height: 2.375rem;
		border-radius: 50%;
		object-fit: cover;
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-global-text) 10%, transparent);
	}
	.glass-brand span {
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.glass-nav {
		position: relative;
	}
	.glass-nav .glass-layers,
	.glass-nav .glass-tint,
	.glass-nav::after,
	.glass-refraction,
	glass-navigation :global(.glass-nav-icon) {
		display: none;
	}
	glass-navigation {
		position: relative;
		display: flex;
		gap: 0.125rem;
		user-select: none;
		-webkit-user-select: none;
		touch-action: pan-y pinch-zoom;
	}
	glass-navigation a {
		position: relative;
		padding: 0.625rem 0.875rem;
		border-radius: 999px;
		color: var(--color-global-text);
		font-size: 0.9375rem;
		font-weight: 550;
		line-height: 1.5rem;
		white-space: nowrap;
		transition:
			color 180ms ease,
			transform 260ms cubic-bezier(0.16, 1.35, 0.32, 1),
			text-shadow 180ms ease;
		text-shadow: 0 1px 6px color-mix(in srgb, var(--color-global-bg) 80%, transparent);
		cursor: grab;
	}
	glass-navigation a[aria-current="page"] {
		font-weight: 650;
		background: var(--chip-fill);
		box-shadow: inset 0 0 0 1px var(--chip-ring);
	}
	glass-navigation[data-ready] a[aria-current="page"] {
		background: transparent;
		box-shadow: none;
	}
	.glass-indicator {
		position: absolute;
		inset: 0 auto auto 0;
		width: 0;
		height: 0;
		border-radius: 999px;
		scale: 1;
		opacity: 0;
		pointer-events: none;
		background:
			linear-gradient(
				168deg,
				rgb(255 255 255 / 38%) 0%,
				rgb(255 255 255 / 10%) 36%,
				transparent 68%
			),
			var(--chip-fill);
		-webkit-backdrop-filter: blur(var(--chip-blur, var(--glass-blur))) saturate(180%);
		backdrop-filter: blur(var(--chip-blur, var(--glass-blur))) saturate(180%);
		box-shadow:
			inset 0 1.2px 0.8px var(--chip-highlight),
			inset 0 -1px 0.6px rgb(0 0 0 / 7%),
			inset 0 0 0 0.5px var(--chip-ring),
			0 3px 10px -2px var(--chip-shadow),
			0 1px 3px 0 var(--chip-shadow);
		transition:
			translate 560ms cubic-bezier(0.16, 1.35, 0.32, 1),
			scale 340ms cubic-bezier(0.16, 1.3, 0.32, 1),
			transform 260ms ease-out,
			width 480ms cubic-bezier(0.16, 1.2, 0.32, 1),
			height 480ms cubic-bezier(0.16, 1.2, 0.32, 1),
			box-shadow 260ms ease,
			opacity 180ms ease,
			filter 260ms ease;
	}
	:global([data-theme="dark"]) .glass-indicator {
		background:
			linear-gradient(
				168deg,
				rgb(255 255 255 / 20%) 0%,
				rgb(255 255 255 / 4%) 42%,
				rgb(0 0 0 / 22%) 100%
			),
			var(--chip-fill);
		box-shadow:
			inset 0 1.2px 0.8px var(--chip-highlight),
			inset 0 -1px 0.6px rgb(0 0 0 / 38%),
			inset 0 0 0 0.5px var(--chip-ring),
			0 4px 14px -2px var(--chip-shadow),
			0 1px 4px 0 rgb(0 0 0 / 35%);
	}
	.glass-actions {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		gap: 0.125rem;
	}
	.glass-actions :global(pagefind-modal-trigger) {
		display: block;
	}
	.glass-actions :global(.pf-trigger-btn),
	.glass-actions :global(.appearance-settings-button) {
		display: grid;
		place-items: center;
		width: 2.625rem;
		height: 2.625rem;
		border-radius: 50%;
		cursor: pointer;
		transition: background-color 180ms ease, transform 180ms ease;
	}
	@media (hover: hover) {
		.glass-actions :global(.pf-trigger-btn:hover),
		.glass-actions :global(.appearance-settings-button:hover) {
			background-color: color-mix(in srgb, var(--color-global-text) 6%, transparent);
		}
	}
	.glass-header :global(a:focus-visible),
	.glass-header :global(button:focus-visible) {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}
	:global(body:has(glass-navigation[data-dragging])),
	glass-navigation[data-dragging],
	glass-navigation[data-dragging] a {
		cursor: grabbing;
	}
	glass-navigation[data-dragging] .glass-indicator { transition: none; }
	@media (prefers-reduced-motion: no-preference) {
		glass-navigation a:active { transform: scale(0.96); }
		.glass-actions :global(.pf-trigger-btn:active),
		.glass-actions :global(.appearance-settings-button:active) { transform: scale(0.94); }

		glass-navigation[data-dragging] .glass-indicator {
			scale: 1.18 1.28;
			transition:
				scale 240ms cubic-bezier(0.18, 1.42, 0.36, 1),
				box-shadow 180ms ease,
				filter 180ms ease;
			filter: brightness(1.15) contrast(1.05);
			-webkit-backdrop-filter: blur(var(--chip-lift-blur, calc(var(--glass-blur) + 4px))) saturate(210%);
			backdrop-filter: blur(var(--chip-lift-blur, calc(var(--glass-blur) + 4px))) saturate(210%);
			box-shadow:
				inset 0 1.5px 1.2px rgb(255 255 255 / 80%),
				inset 0 -1.5px 1.2px rgb(0 0 0 / 14%),
				inset 0 0 0 1px var(--chip-ring),
				0 16px 32px -6px var(--chip-lift-shadow),
				0 6px 14px -3px var(--chip-shadow),
				0 0 20px -2px var(--chip-drag-glow);
		}
	}
	@media (width < 48rem), (hover: none) and (pointer: coarse) and (height < 30rem) {
		.glass-surface {
			--glass-glow-size: 124px 18px;
			--glass-rim-width: 1.45px;
			--glass-bevel: linear-gradient(
				172deg,
				rgb(255 255 255 / 57%),
				transparent 42%,
				rgb(34 48 66 / 17%) 74%,
				rgb(255 255 255 / 36%)
			);
		}
		.glass-tint {
			box-shadow:
				0 14px 36px -18px var(--glass-shadow),
				0 2px 10px -6px var(--glass-shadow),
				inset 0 2px 1.5px -1px rgb(255 255 255 / 38%),
				inset 0 -3px 2px -2px rgb(255 255 255 / 36%);
		}
		.glass-header {
			top: calc(0.5rem + env(safe-area-inset-top, 0px));
			min-height: 3.25rem;
			margin-bottom: 2.5rem;
			padding: 0.25rem 0.5rem 0.25rem 0.75rem;
		}
		.glass-brand { font-size: 1rem; }
		.glass-brand img { width: 2rem; height: 2rem; }

		.glass-actions :global(.pf-trigger-btn),
		.glass-actions :global(.appearance-settings-button) { width: 2.75rem; height: 2.75rem; }

		.glass-nav {
			/* 底栏已模糊背景，滑块中心只轻微柔化，让高光集中在轮廓。 */
			--chip-blur: 0.45px;
			--chip-lift-blur: 0.9px;
			--glass-underlay: color-mix(
				in srgb,
				var(--color-global-bg) min(24%, calc((var(--glass-strength) - 2) * 4%)),
				transparent
			);
			position: fixed;
			inset-inline: max(0.625rem, env(safe-area-inset-left, 0px)) max(0.625rem, env(safe-area-inset-right, 0px));
			inset-block-end: var(--mobile-nav-bottom);
			max-width: 26rem;
			margin-inline: auto;
			padding: 0.3125rem;
			border-radius: 2.25rem;
		}
		.glass-nav .glass-layers,
		.glass-nav .glass-tint,
		.glass-nav::after { display: block; }
		.glass-refraction {
			position: absolute;
			overflow: hidden;
			clip-path: inset(0 round 999px);
			pointer-events: none;
		}
		.glass-dock-refraction {
			inset: 0;
			z-index: -1;
		}
		.glass-refraction-sample {
			position: absolute;
			inset: calc(-1 * var(--mobile-glass-padding));
			contain: strict;
			overflow: hidden;
			background-color: var(--color-global-bg);
			filter: var(--mobile-glass-lens) blur(var(--glass-blur)) saturate(135%) brightness(var(--glass-brightness));
		}
		.glass-dock-refraction:not([hidden]),
		glass-navigation[data-dragging] > .glass-chip-refraction:not([hidden]) { display: block; }
		.glass-nav:has(> .glass-dock-refraction:not([hidden])) > .glass-layers { display: none; }
		glass-navigation[data-dragging]:has(> .glass-chip-refraction:not([hidden])) > .glass-indicator {
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}
		.glass-nav .glass-indicator {
			background:
				radial-gradient(ellipse 58% 23% at 26% 0%, var(--chip-highlight), transparent 90%),
				linear-gradient(176deg, rgb(255 255 255 / 11%), transparent 32% 76%, rgb(255 255 255 / 12%)),
				color-mix(in srgb, var(--chip-fill) 75%, transparent);
			box-shadow:
				inset 0 1.15px 0.8px var(--chip-highlight),
				inset 0 -2px 1.2px color-mix(in srgb, var(--chip-ring) 72%, var(--chip-shadow)),
				inset 0 0 0 0.5px var(--chip-ring),
				0 3px 12px -2px var(--chip-shadow);
		}
		glass-navigation a {
			display: flex;
			flex: 1 1 0;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 0.1875rem;
			min-width: 0;
			min-height: calc(var(--mobile-nav-height) - 0.625rem);
			padding: 0.25rem 0.125rem;
			font-size: 0.75rem;
			line-height: 1.125;
			-webkit-tap-highlight-color: transparent;
		}
		glass-navigation a > span {
			max-width: 100%;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		glass-navigation :global(.glass-nav-icon) {
			display: block;
			flex: none;
			width: 1.375rem;
			height: 1.375rem;
		}
		glass-navigation a[aria-current="page"] :global(.glass-nav-icon) {
			color: var(--color-accent);
		}
		glass-navigation a:focus-visible { outline-offset: -2px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.glass-indicator,
		glass-navigation a,
		.glass-actions :global(.pf-trigger-btn),
		.glass-actions :global(.appearance-settings-button) { transition: none; }
	}
	@media (prefers-reduced-transparency: reduce), (prefers-contrast: more), (forced-colors: active) {
		.glass-dock-refraction:not([hidden]),
		glass-navigation[data-dragging] > .glass-chip-refraction:not([hidden]),
		.glass-surface .glass-optical,
		.glass-surface .glass-warp,
		.glass-surface[data-warp] .glass-optical,
		.glass-surface[data-warp] .glass-warp {
			display: none;
		}
		.glass-tint {
			background-color: var(--color-global-bg);
			background-image: none;
			box-shadow:
				0 14px 36px -18px var(--glass-shadow),
				0 2px 10px -6px var(--glass-shadow),
				inset 0 0 0 1px var(--color-muted);
		}
		.glass-surface::after {
			display: none;
		}
		.glass-indicator,
		glass-navigation[data-dragging] .glass-indicator {
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}
	}
</style>

<script>
	import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
	import { mountMobileGlass } from "./mobile-glass";

	type ChipBox = { x: number; y: number; width: number; height: number };
	type LinkGeometry = ReturnType<typeof measureLink>;
	type Gesture = {
		pointerId: number;
		startX: number;
		startY: number;
		navLeft: number;
		links: LinkGeometry[];
		grabRatio: number;
		clientX: number;
		clientY: number;
		lastMoveTime: number;
		velocity: number;
		dragging: boolean;
	};

	function measureLink(link: HTMLAnchorElement) {
		const x = link.offsetLeft;
		const width = link.offsetWidth;
		return { link, x, y: link.offsetTop, width, height: link.offsetHeight, center: x + width / 2 };
	}

	function getDragDirection(gesture: Gesture, clientX: number, clientY: number) {
		const horizontal = Math.abs(clientX - gesture.startX);
		const vertical = Math.abs(clientY - gesture.startY);
		if (Math.max(horizontal, vertical) < 6) return null;
		return horizontal > vertical ? "horizontal" : "vertical";
	}

	function getDragBox(gesture: Gesture, clientX: number) {
		const { links, navLeft, grabRatio } = gesture;
		const first = links[0];
		const last = links.at(-1);
		if (!first || !last) return null;

		const pointer = clientX - navLeft;
		let before = first;
		let after = first;
		for (const item of links) {
			after = item;
			if (pointer <= item.center) break;
			before = item;
		}

		const span = after.center - before.center;
		const mix = span > 0 ? (pointer - before.center) / span : 0;
		const width = before.width + (after.width - before.width) * mix;
		const height = before.height + (after.height - before.height) * mix;
		const left = pointer - grabRatio * width;
		const x = Math.max(first.x, Math.min(left, last.x + last.width - width));
		return { x, y: first.y, width, height, overshoot: left - x };
	}

	// 上一次滑块的几何（模块级变量，ClientRouter 换页时存活）：
	// 导航重建后滑块从上一页的位置滑到新页的当前项，而不是从 0 尺寸缩放弹出。
	let lastChip: ChipBox | null = null;

	class GlassNavigation extends HTMLElement {
		#controller: AbortController | undefined;
		#resize: ResizeObserver | undefined;
		#frame = 0;
		#dragFrame = 0;
		#labelBounce: Animation | undefined;

		connectedCallback() {
			this.#controller?.abort();
			this.#resize?.disconnect();
			cancelAnimationFrame(this.#frame);
			cancelAnimationFrame(this.#dragFrame);
			this.#frame = 0;
			this.#dragFrame = 0;
			this.#controller = new AbortController();
			const { signal } = this.#controller;
			const header = this.closest<HTMLElement>("header");
			const indicator = this.querySelector<HTMLElement>(".glass-indicator");
			const navigation = this.closest<HTMLElement>("nav");
			if (!header || !indicator || !navigation) return;
			// SVG backdrop 位移在 Chromium 渲染，其他引擎用基础玻璃。
			header.toggleAttribute("data-warp", /(?:Chrome|Chromium|Edg)\//.test(navigator.userAgent));
			const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
			const solidGlass = window.matchMedia("(prefers-reduced-transparency: reduce), (prefers-contrast: more), (forced-colors: active)");
			const links = Array.from(this.querySelectorAll<HTMLAnchorElement>("a"));
			let current = this.querySelector<HTMLAnchorElement>('[aria-current="page"]');
			let gesture: Gesture | null = null;
			let suppressPointerClick = false;
			// 释放捕获后浏览器可能补发边界事件。下一次实际移动或聚焦再恢复预览。
			let deferPreview = false;

			const placeChip = (link: HTMLAnchorElement) => {
				const { x, y, width, height } = measureLink(link);
				indicator.style.width = `${width}px`;
				indicator.style.height = `${height}px`;
				indicator.style.translate = `${x}px ${y}px`;
				indicator.style.transform = "";
				indicator.style.opacity = "1";
				lastChip = { x, y, width, height };
			};
			const moveTo = (link: HTMLAnchorElement | null, animate = true) => {
				if (!link || !this.offsetWidth) {
					indicator.style.opacity = "0";
					delete this.dataset.ready;
					lastChip = null;
					return;
				}
				if (animate && !reducedMotion.matches) {
					placeChip(link);
				}
				else {
					// 首次落位/尺寸变化：先关过渡直接就位并强制重算提交，再恢复过渡，
					// 避免滑块从 0 尺寸初始态带动画定位（缩放弹出）。
					indicator.style.transition = "none";
					placeChip(link);
					void indicator.offsetWidth;
					indicator.style.transition = "";
				}
				this.dataset.ready = "";
			};
			const reset = (animate = true) => {
				if (gesture?.dragging || deferPreview) return;
				const focused = this.contains(document.activeElement) && document.activeElement instanceof HTMLAnchorElement ? document.activeElement : current;
				moveTo(focused, animate);
			};
			const updateDragPosition = (active: Gesture) => {
				const box = getDragBox(active, active.clientX);
				if (!box) return;

				const { x, y, width, height, overshoot } = box;
				const still = reducedMotion.matches;
				const left = still ? x : x + (overshoot * 0.22) / (1 + Math.abs(overshoot) / 80);
				const verticalOffset = still ? 0 : Math.max(-22, Math.min(7, (active.clientY - active.startY) * 0.25));
				const scaleX = overshoot
					? 1 - Math.min(0.12, Math.abs(overshoot) * 0.005)
					: 1 + Math.min(0.14, Math.abs(active.velocity) * 0.08);
				const tilt = Math.max(-2.5, Math.min(2.5, active.velocity * 1.2));

				indicator.style.width = `${width}px`;
				indicator.style.height = `${height}px`;
				indicator.style.translate = `${left}px ${y + verticalOffset}px`;
				indicator.style.transform = still
					? ""
					: `scale(${scaleX}, ${1 / Math.sqrt(scaleX)}) skewX(${tilt}deg)`;

				const center = left + width / 2;
				for (const { link, center: linkCenter, width: linkWidth } of active.links) {
					const reach = linkWidth * 0.8;
					const distance = Math.abs(center - linkCenter);
					if (still || distance >= reach) {
						link.style.transform = "";
						link.style.color = "";
						continue;
					}
					const proximity = 1 - distance / reach;
					const curve = proximity * proximity * (3 - 2 * proximity);
					link.style.transform = `scale(${1 + 0.08 * curve}) translateY(${-2 * curve}px)`;
					link.style.color = `color-mix(in srgb, var(--color-accent) ${50 * curve}%, var(--color-global-text))`;
				}
			};

			const releaseGesture = () => {
				const active = gesture;
				gesture = null;
				if (!active?.dragging) return;

				deferPreview = true;
				suppressPointerClick = true;
				cancelAnimationFrame(this.#dragFrame);
				this.#dragFrame = 0;
				this.removeAttribute("data-dragging");
				for (const { link } of active.links) {
					link.style.transform = "";
					link.style.color = "";
				}
				if (this.hasPointerCapture(active.pointerId)) {
					try {
						this.releasePointerCapture(active.pointerId);
					} catch {}
				}
			};

			const cancelDrag = (animate = true) => {
				const wasDragging = gesture?.dragging;
				releaseGesture();
				if (wasDragging) moveTo(current, animate);
			};

			const onPointerDown = (event: PointerEvent) => {
				if (!event.isPrimary || (gesture && gesture.pointerId !== event.pointerId)) return;
				cancelDrag(false);
				suppressPointerClick = false;
				deferPreview = false;
				if (event.button !== 0 || event.ctrlKey || event.metaKey || event.altKey || event.shiftKey || links.length === 0) return;

				this.#labelBounce?.cancel();
				const navLeft = this.getBoundingClientRect().left;
				const geometry = links.map(measureLink);
				const pointer = event.clientX - navLeft;
				const grabbed = geometry.find(({ x, width }) => width > 0 && pointer >= x && pointer <= x + width);
				const grabRatio = grabbed ? Math.max(0.1, Math.min(0.9, (pointer - grabbed.x) / grabbed.width)) : 0.5;
				gesture = {
					pointerId: event.pointerId,
					startX: event.clientX,
					startY: event.clientY,
					navLeft,
					links: geometry,
					grabRatio,
					clientX: event.clientX,
					clientY: event.clientY,
					lastMoveTime: performance.now(),
					velocity: 0,
					dragging: false,
				};
			};

			const onPointerMove = (event: PointerEvent) => {
				const active = gesture;
				if (!active) {
					if (deferPreview && event.pointerType === "mouse") {
						deferPreview = false;
						const hovered = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("a") : null;
						if (hovered && links.includes(hovered)) moveTo(hovered);
						else reset();
					}
					return;
				}
				if (event.pointerId !== active.pointerId) return;
				if ((event.buttons & 1) === 0) {
					cancelDrag();
					return;
				}

				if (!active.dragging) {
					const direction = getDragDirection(active, event.clientX, event.clientY);
					if (direction === "vertical") {
						releaseGesture();
						return;
					}
					if (!direction) return;

					active.dragging = true;
					this.setAttribute("data-dragging", "");
					indicator.style.opacity = "1";
					this.dataset.ready = "";
					try {
						this.setPointerCapture(active.pointerId);
					} catch {
						// 窗口监听器继续接收结束事件。
					}
				}

				event.preventDefault();
				const now = performance.now();
				const elapsed = Math.max(8, Math.min(now - active.lastMoveTime, 50));
				const speed = (event.clientX - active.clientX) / elapsed;
				active.velocity += (speed - active.velocity) * 0.45;
				active.clientX = event.clientX;
				active.clientY = event.clientY;
				active.lastMoveTime = now;

				if (!this.#dragFrame) {
					this.#dragFrame = requestAnimationFrame(() => {
						this.#dragFrame = 0;
						if (gesture?.dragging) updateDragPosition(gesture);
					});
				}
			};

			const onPointerUp = (event: PointerEvent) => {
				const active = gesture;
				if (!active || active.pointerId !== event.pointerId) return;
				if (!active.dragging || event.button !== 0) {
					cancelDrag();
					return;
				}

				// 同一帧内松手时，最终坐标也参与定位。
				const box = getDragBox(active, event.clientX);
				releaseGesture();
				if (!box) {
					moveTo(current);
					return;
				}

				const center = box.x + box.width / 2;
				let target: HTMLAnchorElement | undefined;
				let minDistance = Infinity;
				for (const item of active.links) {
					const distance = Math.abs(center - item.center);
					if (distance >= minDistance) continue;
					minDistance = distance;
					target = item.link;
				}
				if (!target) return;

				moveTo(target);
				if (!reducedMotion.matches) {
					this.#labelBounce = target.animate(
						[
							{ transform: "scale(1.14) translateY(-2px)" },
							{ transform: "scale(0.95) translateY(1px)" },
							{ transform: "scale(1) translateY(0)" },
						],
						{ duration: 360, easing: "cubic-bezier(0.16, 1.4, 0.32, 1)" },
					);
				}
				if (target !== current) target.click();
			};
			for (const link of links) {
				link.addEventListener("pointerenter", (event) => {
					if (gesture || deferPreview) return;
					if (event.pointerType === "mouse") moveTo(link);
				}, { signal });
				link.addEventListener("focus", () => {
					if (gesture?.dragging) return;
					deferPreview = false;
					moveTo(link);
				}, { signal });
			}
			this.addEventListener("pointerdown", onPointerDown, { signal });
			this.addEventListener("touchmove", (event) => {
				const touch = event.touches[0];
				if (!gesture || !touch || event.touches.length !== 1 || !event.cancelable) return;
				// 横拖开始后，保持同一个手势，防止后续纵向移动被浏览器接管。
				if (gesture.dragging || getDragDirection(gesture, touch.clientX, touch.clientY) === "horizontal") {
					event.preventDefault();
				}
			}, { passive: false, signal });
			window.addEventListener("pointermove", onPointerMove, { signal });
			window.addEventListener("pointerup", onPointerUp, { signal });
			window.addEventListener("pointercancel", (event) => {
				if (event.pointerId === gesture?.pointerId) cancelDrag();
			}, { signal });
			this.addEventListener("lostpointercapture", (event) => {
				if (event.target === this && event.pointerId === gesture?.pointerId) cancelDrag();
			}, { signal });
			window.addEventListener("blur", () => cancelDrag(false), { signal });
			signal.addEventListener("abort", releaseGesture, { once: true });
			this.addEventListener("dragstart", (e) => e.preventDefault(), { signal });
			this.addEventListener("click", (event) => {
				// 只拦截松手附带的鼠标或触摸点击，键盘和主动触发的链接点击照常执行。
				if (!suppressPointerClick || !event.isTrusted || !event.detail) return;
				suppressPointerClick = false;
				event.preventDefault();
				event.stopImmediatePropagation();
			}, { capture: true, signal });
			this.addEventListener("pointerleave", () => {
				if (!gesture) reset();
			}, { signal });
			this.addEventListener("focusout", () => {
				queueMicrotask(() => {
					if (!signal.aborted) reset();
				});
			}, { signal });
			reducedMotion.addEventListener("change", () => {
				if (!reducedMotion.matches) return;
				this.#labelBounce?.cancel();
				if (gesture?.dragging) updateDragPosition(gesture);
			}, { signal });
			// 高光位置与光源角度都用百分比/角度保留，离开后停在最后状态，不再复位到固定坐标。
			const startGlow = Number.parseFloat(header.style.getPropertyValue("--glass-x"));
			const startAngle = Number.parseFloat(getComputedStyle(header).getPropertyValue("--light-angle"));
			let glowPosition = Number.isFinite(startGlow) ? startGlow : 30;
			let lightAngle = Number.isFinite(startAngle) ? (((startAngle % 360) + 360) % 360) : 310;
			let glowTarget = glowPosition;
			let angleTarget = lightAngle;
			let lastFrame = 0;
			let lightPoint: { x: number; y: number; withinNavigation: boolean } | null = null;
			const followLight = (now: number) => {
				this.#frame = 0;
				if (signal.aborted || reducedMotion.matches || solidGlass.matches) return;
				if (lightPoint) {
					const headerRect = header.getBoundingClientRect();
					const navRect = lightPoint.withinNavigation ? navigation.getBoundingClientRect() : headerRect;
					const rect = navRect.top >= headerRect.bottom ? navRect : headerRect;
					if (rect.width) {
						glowTarget = Math.max(0, Math.min(100, ((lightPoint.x - rect.left) / rect.width) * 100));
						const angle = Math.atan2(lightPoint.y - (rect.top + rect.height / 2), lightPoint.x - (rect.left + rect.width / 2));
						angleTarget = ((angle * (180 / Math.PI) + 450) % 360);
					}
					lightPoint = null;
				}
				const elapsed = lastFrame ? Math.min(now - lastFrame, 64) : 16;
				lastFrame = now;
				const ease = 1 - Math.exp(-elapsed / 65);
				glowPosition += (glowTarget - glowPosition) * ease;
				// 角度走最短弧，避免从 350° 追 10° 时反向转一大圈。
				const shortestAngle = ((((angleTarget - lightAngle) % 360) + 540) % 360) - 180;
				lightAngle = (((lightAngle + shortestAngle * ease) % 360) + 360) % 360;
				const glowSettled = Math.abs(glowTarget - glowPosition) < 0.02;
				const angleSettled = Math.abs(shortestAngle) < 0.05;
				if (glowSettled) glowPosition = glowTarget;
				if (angleSettled) lightAngle = angleTarget;
				header.style.setProperty("--glass-x", `${glowPosition}%`);
				header.style.setProperty("--light-angle", `${lightAngle}deg`);
				if (!glowSettled || !angleSettled) this.#frame = requestAnimationFrame(followLight);
			};
			const aimLight = (event: PointerEvent) => {
				if (reducedMotion.matches || solidGlass.matches) return;
				lightPoint = {
					x: event.clientX,
					y: event.clientY,
					withinNavigation: event.target instanceof Node && navigation.contains(event.target),
				};
				if (!this.#frame) {
					lastFrame = 0;
					this.#frame = requestAnimationFrame(followLight);
				}
			};
			header.addEventListener("pointermove", (event) => {
				const dragging = gesture?.dragging && gesture.pointerId === event.pointerId;
				if (event.pointerType === "mouse" || dragging) aimLight(event);
			}, { signal, passive: true });
			header.addEventListener("pointerdown", (event) => {
				if (event.isPrimary && event.pointerType === "touch") aimLight(event);
			}, { signal, passive: true });
			// observe() 会先发一次初始通知，跳过它，否则会打断首次落位的滑入动画。
			let resizePrimed = false;
			this.#resize = new ResizeObserver(() => {
				if (!resizePrimed) {
					resizePrimed = true;
					return;
				}
				if (gesture) cancelDrag(false);
				else reset(false);
			});
			this.#resize.observe(this);
			// 首次落位：客户端导航重建后从上一页的位置滑到新页当前项；首次访问直接就位。
			if (current && this.offsetWidth && lastChip && !reducedMotion.matches) {
				indicator.style.transition = "none";
				indicator.style.width = `${lastChip.width}px`;
				indicator.style.height = `${lastChip.height}px`;
				indicator.style.translate = `${lastChip.x}px ${lastChip.y}px`;
				indicator.style.transform = "";
				indicator.style.opacity = "1";
				void indicator.offsetWidth;
				indicator.style.transition = "";
				placeChip(current);
				this.dataset.ready = "";
			}
			else {
				reset(false);
			}
			mountMobileGlass(navigation, this, indicator, solidGlass, signal);
			document.addEventListener("astro:before-swap", (event) => {
				const { newDocument } = event as TransitionBeforeSwapEvent;
				const nextHeader = newDocument.getElementById("main-header");
				if (!nextHeader) return;
				nextHeader.toggleAttribute("data-warp", header.hasAttribute("data-warp"));
				for (const property of ["--glass-x", "--light-angle"]) {
					nextHeader.style.setProperty(property, header.style.getPropertyValue(property));
				}
			}, { signal });
			document.addEventListener("astro:page-load", () => {
				// 保险：若组件在客户端导航中被保留（未重建），aria-current 已更新但引用过期，滑到新的当前项。
				const latest = this.querySelector<HTMLAnchorElement>('[aria-current="page"]');
				if (latest !== current) {
					current = latest;
					deferPreview = false;
					reset();
				}
			}, { signal });
		}

		disconnectedCallback() {
			this.#controller?.abort();
			this.#resize?.disconnect();
			cancelAnimationFrame(this.#frame);
			cancelAnimationFrame(this.#dragFrame);
			this.#labelBounce?.cancel();
			this.#frame = 0;
			this.#dragFrame = 0;
		}
	}
	customElements.define("glass-navigation", GlassNavigation);
</script>
