---
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks, siteConfig } from "@/site.config";
---

<header class="glass-header glass-surface" id="main-header">
	<a class="glass-brand" href="/" aria-label={`${siteConfig.title} · 首页`}>
		<img alt="" src="/killua.webp" width="38" height="38" />
		<span>{siteConfig.title}</span>
	</a>
	<nav class="glass-nav glass-surface" aria-label="主导航" id="navigation-menu">
		<glass-navigation>
			<span class="glass-indicator" aria-hidden="true"></span>
			{menuLinks.map((link) => (
				<a
					aria-current={(link.path === "/" ? Astro.url.pathname === "/" : Astro.url.pathname.startsWith(link.path)) ? "page" : undefined}
					href={link.path}
				>{link.title}</a>
			))}
		</glass-navigation>
	</nav>
	<div class="glass-actions">
		<Search />
		<ThemeToggle />
		<button
			aria-expanded="false"
			aria-controls="navigation-menu"
			aria-label="打开导航菜单"
			class="glass-menu-button"
			id="toggle-navigation-menu"
			type="button"
		>
			<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
				<path class="menu-line" d="M5 8h14M5 16h14" />
				<path class="menu-cross" d="m7 7 10 10M7 17 17 7" />
			</svg>
		</button>
	</div>
</header>

<style>
	/* 玻璃放在伪元素上，避免 header 自身成为 backdrop root，影响移动端浮层。 */
	.glass-surface {
		--glass-tint: color-mix(in srgb, var(--color-global-bg) 4%, transparent);
		--glass-rim: rgb(255 255 255 / 38%);
		--glass-glow: rgb(255 255 255 / 30%);
		--glass-shadow: rgb(26 36 48 / 7%);
		isolation: isolate;
	}
	:global([data-theme="dark"]) .glass-surface {
		--glass-tint: color-mix(in srgb, var(--color-global-bg) 6%, transparent);
		--glass-rim: rgb(255 255 255 / 16%);
		--glass-glow: rgb(255 255 255 / 14%);
		--glass-shadow: rgb(0 0 0 / 18%);
	}
	.glass-surface::before,
	.glass-surface::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		pointer-events: none;
	}
	.glass-surface::before {
		/* 不支持 backdrop-filter 时使用实色，保证文字可读。 */
		background: var(--color-global-bg);
		box-shadow:
			0 8px 32px -12px var(--glass-shadow),
			0 2px 8px -4px var(--glass-shadow);
	}
	@supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		.glass-surface::before {
			background: var(--glass-tint);
			-webkit-backdrop-filter: blur(2.5px) saturate(135%);
			backdrop-filter: blur(2.5px) saturate(135%);
		}
	}
	.glass-surface::after {
		border: 1px solid var(--glass-rim);
		background:
			radial-gradient(180px 18px at var(--glass-x, 30%) 0%, var(--glass-glow), transparent 80%),
			linear-gradient(155deg, rgb(255 255 255 / 2.5%), transparent 40%, rgb(255 255 255 / 0.8%));
		box-shadow:
			inset 0 1px 1px rgb(255 255 255 / 12%),
			inset 0 -1px 1px color-mix(in srgb, var(--color-global-text) 3%, transparent);
	}
	.glass-header {
		position: sticky;
		top: max(1rem, env(safe-area-inset-top));
		z-index: 60;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		min-height: 4rem;
		margin-bottom: 4rem;
		padding: 0.5rem 0.625rem 0.5rem 0.75rem;
		border-radius: 2.5rem;
	}
	.glass-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		min-width: 0;
		color: var(--color-accent-2);
		font-size: 1rem;
		font-weight: 650;
		letter-spacing: -0.035em;
		white-space: nowrap;
		border-radius: 999px;
	}
	.glass-brand img {
		flex-shrink: 0;
		width: 2.375rem;
		height: 2.375rem;
		border-radius: 50%;
		object-fit: cover;
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-global-text) 10%, transparent);
	}
	.glass-nav {
		position: absolute;
		inset: calc(100% + 0.625rem) 0 auto;
		display: none;
		padding: 0.5rem;
		border-radius: 1.75rem;
	}
	.glass-header[data-menu-open] .glass-nav {
		display: block;
		animation: glass-menu-in 180ms ease-out;
	}
	glass-navigation {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		/* 横屏和放大文字时仍能滚动到最后一项，不让菜单伸出可视区域。 */
		max-height: max(2.75rem, calc(100vh - 9rem));
		max-height: max(2.75rem, calc(100dvh - 9rem - env(safe-area-inset-top) - env(safe-area-inset-bottom)));
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-width: thin;
	}
	glass-navigation a {
		position: relative;
		padding: 0.625rem 1rem;
		border-radius: 999px;
		color: var(--color-global-text);
		font-size: 0.9375rem;
		font-weight: 550;
		line-height: 1.5rem;
		white-space: nowrap;
		transition: color 180ms ease;
		text-shadow: 0 1px 6px color-mix(in srgb, var(--color-global-bg) 80%, transparent);
	}
	glass-navigation a[aria-current="page"] {
		color: var(--color-accent);
		font-weight: 650;
		background: color-mix(in srgb, var(--color-global-text) 5%, transparent);
	}
	.glass-indicator {
		display: none;
		position: absolute;
		inset: 0 auto auto 0;
		width: 0;
		height: 0;
		border-radius: 999px;
		opacity: 0;
		background: color-mix(in srgb, var(--color-global-text) 5%, transparent);
		box-shadow: inset 0 1px 1px color-mix(in srgb, var(--color-global-bg) 20%, transparent), 0 1px 3px rgb(0 0 0 / 3%);
		transition:
			transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
			width 360ms cubic-bezier(0.22, 1, 0.36, 1),
			height 360ms cubic-bezier(0.22, 1, 0.36, 1),
			opacity 180ms ease;
	}
	.glass-actions {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		gap: 0.125rem;
	}
	.glass-actions :global(theme-toggle),
	.glass-actions :global(pagefind-modal-trigger) {
		display: block;
	}
	.glass-actions :global(theme-toggle button),
	.glass-actions :global(.pf-trigger-btn),
	.glass-menu-button {
		display: grid;
		place-items: center;
		width: 2.625rem;
		height: 2.625rem;
		border-radius: 50%;
		cursor: pointer;
		transition: background-color 180ms ease, transform 180ms ease;
	}
	@media (hover: hover) {
		.glass-actions :global(theme-toggle button:hover),
		.glass-actions :global(.pf-trigger-btn:hover),
		.glass-menu-button:hover {
			background-color: color-mix(in srgb, var(--color-global-text) 6%, transparent);
		}
	}
	.glass-actions :global(theme-toggle button:active),
	.glass-actions :global(.pf-trigger-btn:active),
	.glass-menu-button:active {
		transform: scale(0.94);
	}
	.glass-header :global(a:focus-visible),
	.glass-header :global(button:focus-visible) {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}
	.glass-menu-button svg {
		width: 1.5rem;
		height: 1.5rem;
	}
	.menu-cross,
	.glass-menu-button[aria-expanded="true"] .menu-line {
		opacity: 0;
	}
	.glass-menu-button[aria-expanded="true"] .menu-cross {
		opacity: 1;
	}
	@keyframes glass-menu-in {
		/* 不能给玻璃的祖先做 opacity 动画：opacity < 1 会建立新的 backdrop root，
		   子层采样不到页面，结束时才恢复模糊，形成透明→玻璃的闪烁。 */
		from { transform: translateY(-6px); }
		to { transform: translateY(0); }
	}
	@media (min-width: 48rem) {
		.glass-header { padding-inline: 0.875rem 0.625rem; }
		.glass-brand { font-size: 1.125rem; }
		.glass-nav,
		.glass-header[data-menu-open] .glass-nav {
			position: relative;
			inset: auto;
			display: block;
			padding: 0;
			animation: none;
		}
		.glass-nav::before,
		.glass-nav::after { display: none; }
		glass-navigation { flex-direction: row; max-height: none; overflow: visible; }
		glass-navigation a { padding-inline: 0.875rem; }
		glass-navigation[data-ready] a[aria-current="page"] { background: transparent; }
		.glass-indicator { display: block; }
		.glass-menu-button { display: none; }
	}
	@media (max-width: 23rem) {
		.glass-brand { gap: 0.375rem; font-size: 0.875rem; }
		.glass-brand img { width: 1.875rem; height: 1.875rem; }
		.glass-actions :global(theme-toggle button),
		.glass-actions :global(.pf-trigger-btn),
		.glass-menu-button { width: 2.25rem; height: 2.25rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.glass-indicator,
		glass-navigation a,
		.glass-actions :global(button) { transition: none; }
		.glass-header[data-menu-open] .glass-nav { animation: none; }
	}
	@media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
		.glass-surface::before {
			background: var(--color-global-bg);
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}
		.glass-surface::after { background: none; border-color: var(--color-muted); }
	}
</style>

<script>
	class GlassNavigation extends HTMLElement {
		#controller: AbortController | undefined;
		#resize: ResizeObserver | undefined;
		#frame = 0;

		connectedCallback() {
			this.#controller?.abort();
			this.#resize?.disconnect();
			cancelAnimationFrame(this.#frame);
			this.#frame = 0;
			this.#controller = new AbortController();
			const { signal } = this.#controller;
			const header = this.closest<HTMLElement>("header");
			const indicator = this.querySelector<HTMLElement>(".glass-indicator");
			const button = header?.querySelector<HTMLButtonElement>(".glass-menu-button");
			if (!header || !indicator || !button) return;
			const desktop = window.matchMedia("(min-width: 48rem)");
			const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
			const current = this.querySelector<HTMLAnchorElement>('[aria-current="page"]');
			const moveTo = (link: HTMLAnchorElement | null) => {
				// 手机端只用 aria-current 标记所在页，不能把触摸/焦点当成选中态。
				if (!desktop.matches || !link || !this.offsetWidth) {
					indicator.style.opacity = "0";
					return;
				}
				indicator.style.width = `${link.offsetWidth}px`;
				indicator.style.height = `${link.offsetHeight}px`;
				indicator.style.transform = `translate(${link.offsetLeft}px, ${link.offsetTop}px)`;
				indicator.style.opacity = "1";
				this.dataset.ready = "";
			};
			const reset = () => {
				const focused = this.contains(document.activeElement) && document.activeElement instanceof HTMLAnchorElement ? document.activeElement : current;
				moveTo(focused);
			};
			const setOpen = (open: boolean) => {
				header.toggleAttribute("data-menu-open", open);
				button.setAttribute("aria-expanded", String(open));
				button.setAttribute("aria-label", open ? "关闭导航菜单" : "打开导航菜单");
				if (!desktop.matches) {
					if (open) {
						const target = current ?? this.querySelector("a");
						if (target) {
							target.focus({ preventScroll: true });
							this.scrollTop = target.offsetTop - (this.clientHeight - target.offsetHeight) / 2;
						}
					}
					else if (this.contains(document.activeElement)) button.focus({ preventScroll: true });
				}
				reset();
			};
			button.addEventListener("click", () => setOpen(!header.hasAttribute("data-menu-open")), { signal });
			this.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
				link.addEventListener("pointerenter", (event) => {
					if (event.pointerType === "mouse") moveTo(link);
				}, { signal });
				link.addEventListener("focus", () => moveTo(link), { signal });
				link.addEventListener("click", () => setOpen(false), { signal });
			});
			this.addEventListener("pointerleave", reset, { signal });
			this.addEventListener("focusout", () => queueMicrotask(reset), { signal });
			header.addEventListener("focusout", (event) => {
				// Safari 点按按钮可能先把焦点交给 body（relatedTarget=null）。
				// 这种情况交由 click 处理，否则会先关闭、再被同一次 click 重新打开。
				const next = event.relatedTarget;
				if (next instanceof Node && next !== document.body && !header.contains(next)) setOpen(false);
			}, { signal });
			header.addEventListener("click", (event) => {
				if (event.target instanceof Element && event.target.closest("theme-toggle, pagefind-modal-trigger")) setOpen(false);
			}, { signal });
			document.addEventListener("pointerdown", (event) => {
				if (event.target instanceof Node && !header.contains(event.target)) setOpen(false);
			}, { signal });
			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && header.hasAttribute("data-menu-open")) {
					setOpen(false);
					button.focus();
				}
			}, { signal });
			desktop.addEventListener("change", () => setOpen(false), { signal });
			// 用百分比保留高光位置，离开或调整窗口后都不会突然回到 CSS 默认位置。
			const storedGlowPosition = Number.parseFloat(header.style.getPropertyValue("--glass-x"));
			let glowPosition = Number.isFinite(storedGlowPosition) ? storedGlowPosition : 30;
			let glowTarget = glowPosition;
			let lastFrame = 0;
			const followGlow = (now: number) => {
				this.#frame = 0;
				if (signal.aborted || reducedMotion.matches) return;
				const elapsed = lastFrame ? Math.min(now - lastFrame, 64) : 16;
				lastFrame = now;
				glowPosition += (glowTarget - glowPosition) * (1 - Math.exp(-elapsed / 65));
				if (Math.abs(glowTarget - glowPosition) < 0.02) glowPosition = glowTarget;
				header.style.setProperty("--glass-x", `${glowPosition}%`);
				if (glowPosition !== glowTarget) this.#frame = requestAnimationFrame(followGlow);
			};
			header.addEventListener("pointermove", (event) => {
				if (event.pointerType !== "mouse" || reducedMotion.matches) return;
				const rect = header.getBoundingClientRect();
				if (!rect.width) return;
				glowTarget = Math.max(0, Math.min(100, ((event.clientX - rect.left) / rect.width) * 100));
				if (!this.#frame) {
					lastFrame = 0;
					this.#frame = requestAnimationFrame(followGlow);
				}
			}, { signal, passive: true });
			this.#resize = new ResizeObserver(reset);
			this.#resize.observe(this);
			reset();
		}

		disconnectedCallback() {
			this.#controller?.abort();
			this.#resize?.disconnect();
			cancelAnimationFrame(this.#frame);
			this.#frame = 0;
		}
	}
	customElements.define("glass-navigation", GlassNavigation);
</script>
