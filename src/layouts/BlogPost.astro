---
import { type CollectionEntry, render } from "astro:content";

import Masthead from "@/components/blog/Masthead.astro";
import TOC from "@/components/blog/TOC.astro";
import WebMentions from "@/components/blog/webmentions/index.astro";
import Giscus from "@/components/Giscus.astro";

import BaseLayout from "./Base.astro";

interface Props {
	post: CollectionEntry<"post">;
	newerPost?: CollectionEntry<"post"> | null;
	olderPost?: CollectionEntry<"post"> | null;
}

const { post, newerPost = null, olderPost = null } = Astro.props;
const { ogImage, title, description, updatedDate, publishDate } = post.data;
const socialImage = ogImage ?? `/og-image/${post.id}.png`;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
const { headings, remarkPluginFrontmatter } = await render(post);
const readingTime = `约 ${remarkPluginFrontmatter.readingTimeMinutes as number} 分钟`;
---

<BaseLayout
	meta={{
		articleDate,
		description,
		ogImage: socialImage,
		title,
	}}
>
	<article class="grow break-words" data-pagefind-body>
		<div id="reading-progress" class="bg-accent fixed start-0 top-0 z-50 h-0.5" style="width: 0%"></div>
		<div id="blog-hero" class="mb-12"><Masthead content={post} readingTime={readingTime} /></div>
		<div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
			{!!headings.length && <TOC headings={headings} />}
			<div
				class="prose prose-headings:font-semibold prose-headings:text-accent-2 prose-headings:before:absolute prose-headings:before:-ms-4 prose-headings:before:text-muted prose-headings:hover:before:text-accent sm:prose-headings:before:content-['#'] sm:prose-th:before:content-none"
			>
					<slot />
					<WebMentions />
					<Giscus />
			</div>
		</div>
		{
			/* 上一篇/下一篇：列表位置更靠上的为"上一篇"（更新），靠下的为"下一篇"（更早） */
			(newerPost || olderPost) && (
				<nav class="border-muted/25 mt-16 grid gap-6 border-t pt-8 sm:grid-cols-2" aria-label="文章导航">
					{newerPost ? (
						<a class="group" href={`/posts/${newerPost.id}/`}>
							<span class="text-muted font-mono text-sm">← 上一篇</span>
							<span class="cactus-link mt-1 inline-block font-semibold">{newerPost.data.title}</span>
						</a>
					) : (
						<span />
					)}
					{olderPost && (
						<a class="group text-end sm:col-start-2" href={`/posts/${olderPost.id}/`}>
							<span class="text-muted font-mono text-sm">下一篇 →</span>
							<span class="cactus-link mt-1 inline-block font-semibold">{olderPost.data.title}</span>
						</a>
					)}
				</nav>
			)
		}
	</article>
	<!-- 图片灯箱：点击正文图片放大查看；滚轮缩放、拖拽平移、双击复位，点击图片外 / X / ESC 关闭 -->
	<div
		aria-modal="true"
		class="fixed inset-0 z-100 flex cursor-zoom-out items-center justify-center bg-black/80 p-4"
		id="lightbox"
		role="dialog"
	>
		<button
			aria-label="关闭大图"
			class="absolute end-4 top-4 cursor-pointer rounded-full bg-white/10 p-2 text-white hover:bg-white/25"
			id="lightbox-close"
			type="button"
		>
			<svg
				aria-hidden="true"
				class="h-6 w-6"
				fill="none"
				stroke="currentColor"
				stroke-linecap="round"
				stroke-width="2"
				viewBox="0 0 24 24"
			>
				<path d="M6 6l12 12M18 6L6 18" />
			</svg>
		</button>
		<img alt="" class="max-h-[90vh] max-w-full cursor-default object-contain" id="lightbox-img" src="" />
	</div>
	<button
		class="hover:border-link fixed end-4 bottom-8 z-90 flex h-10 w-10 translate-y-28 cursor-pointer items-center justify-center rounded-full border-2 border-transparent bg-zinc-200 text-3xl opacity-0 transition-all transition-discrete duration-300 data-[show=true]:translate-y-0 data-[show=true]:opacity-100 sm:end-8 sm:h-12 sm:w-12 dark:bg-zinc-700"
		data-show="false"
		id="to-top-btn"
	>
		<span class="sr-only">Back to top</span>
		<svg
			aria-hidden="true"
			class="h-6 w-6"
			fill="none"
			focusable="false"
			stroke="currentColor"
			stroke-width="2"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path d="M4.5 15.75l7.5-7.5 7.5 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
	</button>
</BaseLayout>

<style>
	#lightbox {
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.2s ease,
			visibility 0.2s;
	}
	#lightbox.open {
		opacity: 1;
		visibility: visible;
	}
	#lightbox img {
		transform: scale(0.96);
		transition: transform 0.2s ease;
		/* 拖拽平移 / 双指捏合由 JS 接管，禁止浏览器的选中与默认触摸手势 */
		user-select: none;
		touch-action: none;
	}
	#lightbox.open img {
		transform: scale(1);
	}
</style>

<script>
	// ClientRouter 下模块脚本只执行一次，因此初始化逻辑改为响应 astro:page-load，
	// 每次进入文章页重新绑定；并在重新绑定前清理上一页的 document 级监听器，避免累积。
	let headerObserver: IntersectionObserver | null = null;
	let onScroll: (() => void) | null = null;
	let onKeydown: ((e: KeyboardEvent) => void) | null = null;

	document.addEventListener("astro:page-load", () => {
		// 清理上一篇文章页注册的 document 级监听器与观察器
		headerObserver?.disconnect();
		if (onScroll) document.removeEventListener("scroll", onScroll);
		if (onKeydown) document.removeEventListener("keydown", onKeydown);
		headerObserver = null;
		onScroll = null;
		onKeydown = null;

		const scrollBtn = document.getElementById("to-top-btn") as HTMLButtonElement;
		const targetHeader = document.getElementById("blog-hero") as HTMLDivElement;
		const progressBar = document.getElementById("reading-progress") as HTMLDivElement;
		const lightbox = document.getElementById("lightbox") as HTMLDivElement;
		const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
		// 非文章页没有这些元素，直接跳过
		if (!scrollBtn || !targetHeader || !progressBar || !lightbox || !lightboxImg) return;

		function callback(entries: IntersectionObserverEntry[]) {
			entries.forEach((entry) => {
				// only show the scroll to top button when the heading is out of view
				scrollBtn.dataset.show = (!entry.isIntersecting).toString();
			});
		}

		scrollBtn.addEventListener("click", () => {
			document.documentElement.scrollTo({ behavior: "smooth", top: 0 });
		});

		headerObserver = new IntersectionObserver(callback);
		headerObserver.observe(targetHeader);

		// 顶部阅读进度条
		function updateProgress() {
			const root = document.documentElement;
			const max = root.scrollHeight - root.clientHeight;
			progressBar.style.width = `${max > 0 ? (root.scrollTop / max) * 100 : 0}%`;
		}
		onScroll = updateProgress;
		document.addEventListener("scroll", onScroll, { passive: true });
		updateProgress();

		// 图片灯箱：点击正文图片放大，点击图片外 / X / ESC 关闭；
		// 打开后支持滚轮缩放（以光标为中心）、拖拽平移、双击切换放大/复位，移动端支持双指捏合
		let scale = 1;
		let tx = 0;
		let ty = 0;
		const MIN_SCALE = 0.5;
		const MAX_SCALE = 8;

		function applyTransform() {
			// 用户交互驱动的缩放要即时响应，关掉 CSS 的入场过渡
			lightboxImg.style.transition = "none";
			lightboxImg.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
			lightboxImg.style.cursor = scale > 1 ? "grab" : "";
		}

		function resetZoom() {
			scale = 1;
			tx = 0;
			ty = 0;
			// 清掉内联样式，交还给 CSS 的入场过渡
			lightboxImg.style.transition = "";
			lightboxImg.style.transform = "";
			lightboxImg.style.cursor = "";
		}

		function zoomAt(clientX: number, clientY: number, nextScale: number) {
			nextScale = Math.min(MAX_SCALE, Math.max(MIN_SCALE, nextScale));
			// 接近原始尺寸时吸附复位，避免浮点误差导致回不去
			if (Math.abs(nextScale - 1) < 0.05) nextScale = 1;
			// 光标相对图片中心的位置（getBoundingClientRect 已包含当前 transform）
			const rect = lightboxImg.getBoundingClientRect();
			const px = clientX - (rect.left + rect.width / 2);
			const py = clientY - (rect.top + rect.height / 2);
			// transform-origin 是图片中心，反推平移量让缩放锚定光标
			const ratio = nextScale / scale;
			tx = px - ratio * (px - tx);
			ty = py - ratio * (py - ty);
			scale = nextScale;
			if (scale === 1) {
				tx = 0;
				ty = 0;
			}
			applyTransform();
		}

		function closeLightbox() {
			lightbox.classList.remove("open");
			document.body.style.overflow = "";
			resetZoom();
		}
		document.querySelectorAll<HTMLImageElement>(".prose img").forEach((img) => {
			if (img.closest("a")) return; // 跳过链接里的图（如 wandb 徽章），保留跳转行为
			img.style.cursor = "zoom-in";
			img.addEventListener("click", () => {
				resetZoom();
				lightboxImg.src = img.currentSrc || img.src;
				lightboxImg.alt = img.alt;
				lightbox.classList.add("open");
				document.body.style.overflow = "hidden";
			});
		});
		// X 按钮也在遮罩内，点击图片之外的任何位置都会触发关闭
		lightbox.addEventListener("click", (e) => {
			if (e.target !== lightboxImg) closeLightbox();
		});

		// 滚轮缩放（光标在遮罩任意位置都生效）
		lightbox.addEventListener(
			"wheel",
			(e) => {
				if (!lightbox.classList.contains("open")) return;
				e.preventDefault();
				zoomAt(e.clientX, e.clientY, scale * (e.deltaY < 0 ? 1.2 : 1 / 1.2));
			},
			{ passive: false },
		);

		// 双击在放大 2.5 倍和复位之间切换
		lightboxImg.addEventListener("dblclick", (e) => {
			e.preventDefault();
			if (scale > 1) resetZoom();
			else zoomAt(e.clientX, e.clientY, 2.5);
		});

		// 拖拽平移 + 双指捏合缩放（统一走 Pointer Events）
		const activePointers = new Map<number, { x: number; y: number }>();
		let dragStart: { x: number; y: number; tx: number; ty: number } | null = null;
		let pinchAnchor: { dist: number; scale: number } | null = null;
		let lastMid: { x: number; y: number } | null = null;

		lightboxImg.addEventListener("dragstart", (e) => e.preventDefault());
		lightboxImg.addEventListener("pointerdown", (e) => {
			lightboxImg.setPointerCapture(e.pointerId);
			activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
			if (activePointers.size === 1) {
				dragStart = { x: e.clientX, y: e.clientY, tx, ty };
				pinchAnchor = null;
				lastMid = null;
			} else if (activePointers.size === 2) {
				const points = [...activePointers.values()];
				const a = points[0]!;
				const b = points[1]!;
				pinchAnchor = { dist: Math.hypot(a.x - b.x, a.y - b.y), scale };
				lastMid = { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
				dragStart = null;
			}
		});
		lightboxImg.addEventListener("pointermove", (e) => {
			if (!activePointers.has(e.pointerId)) return;
			activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
			if (pinchAnchor && lastMid && activePointers.size === 2) {
				// 双指：先跟随中点平移，再按间距比例以中点为中心缩放
				const points = [...activePointers.values()];
				const a = points[0]!;
				const b = points[1]!;
				const dist = Math.hypot(a.x - b.x, a.y - b.y);
				const midX = (a.x + b.x) / 2;
				const midY = (a.y + b.y) / 2;
				tx += midX - lastMid.x;
				ty += midY - lastMid.y;
				lastMid = { x: midX, y: midY };
				zoomAt(midX, midY, pinchAnchor.scale * (dist / pinchAnchor.dist));
			} else if (dragStart && scale > 1) {
				tx = dragStart.tx + (e.clientX - dragStart.x);
				ty = dragStart.ty + (e.clientY - dragStart.y);
				applyTransform();
			}
		});
		function endPointer(e: PointerEvent) {
			activePointers.delete(e.pointerId);
			pinchAnchor = null;
			lastMid = null;
			if (activePointers.size === 0) {
				dragStart = null;
			} else if (activePointers.size === 1) {
				// 双指抬起其一后回到单指拖动，以当前位置重新起算，避免跳动
				const p = [...activePointers.values()][0]!;
				dragStart = { x: p.x, y: p.y, tx, ty };
			}
		}
		lightboxImg.addEventListener("pointerup", endPointer);
		lightboxImg.addEventListener("pointercancel", endPointer);
		onKeydown = (e) => {
			if (e.key === "Escape" && lightbox.classList.contains("open")) closeLightbox();
		};
		document.addEventListener("keydown", onKeydown);
	});
</script>
