{
	"name": "yowakkojay-blog",
	"type": "module",
	"version": "7.2.0",
	"private": true,
	"engines": { "node": ">=22.23.4" },
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"postbuild": "pagefind --site dist && npm run check:links",
		"check:links": "node scripts/check-links.mjs",
		"test": "node --experimental-strip-types --test tests/*.test.ts",
		"new:post": "node scripts/new-content.mjs post",
		"new:note": "node scripts/new-content.mjs note",
		"preview": "astro preview",
		"check": "astro check && biome check",
		"lint": "biome check --write",
		"format": "prettier -w . --cache"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.6",
		"@astrojs/mdx": "8.1.3",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.4",
		"@pagefind/component-ui": "^1.6.0",
		"@tailwindcss/vite": "4.3.5",
		"astro": "7.4.7",
		"astro-expressive-code": "^0.44.3",
		"astro-icon": "^1.2.0",
		"hastscript": "^9.0.0",
		"katex": "^0.19.1",
		"mdast-util-directive": "^3.0.0",
		"mdast-util-to-hast": "^13.2.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-katex": "^7.0.1",
		"rehype-unwrap-images": "^1.0.0",
		"remark-directive": "^4.0.0",
		"remark-math": "^6.0.0",
		"satori": "0.63.2",
		"satori-html": "^0.3.2",
		"sharp": "^0.35.5",
		"tailwindcss": "^4.3.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@biomejs/biome": "^2.4.15",
		"@iconify-json/mdi": "^1.2.2",
		"@tailwindcss/typography": "^0.5.19",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"@types/node": "^22.0.0",
		"parse5": "^8.0.0",
		"pagefind": "^1.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"reading-time": "^1.5.0",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"sharp": "$sharp",
		"katex": "$katex",
		"satori": { "fflate": "^0.7.5" },
		"@tailwindcss/typography": { "postcss-selector-parser": "^6.1.5" }
	}
}
